/**
 * Ruyi Standard Library - String Utility Module
 *
 * Provides standalone string utility functions.
 * For string instance methods (split, contains, trim, etc.),
 * use the core module which is automatically available.
 *
 * @author Ruyi Team
 * @date 2026-05-02
 */

// ============================================================
// String Utility Functions
// ============================================================

/**
 * Joins array elements into a string with separator.
 * @param array Array of values to join
 * @param separator Separator string (default: "")
 * @return Joined string
 */
export fn join(array: Array<dyn>, separator: string = ""): string {
    return __string_join(array, separator);
}

/**
 * Creates a string from character code.
 * @param code Unicode code point
 * @return Single character string
 */
export fn fromCharCode(code: int): string {
    return __string_from_char_code(code);
}

/**
 * Creates a string from an array of character codes.
 * @param codes Array of Unicode code points
 * @return String constructed from codes
 */
export fn fromCharCodes(codes: Array<int>): string {
    return __string_from_char_codes(codes);
}

/**
 * Creates a string by concatenating all arguments.
 * @param args Values to concatenate
 * @return Concatenated string
 */
export fn concat(args: ...string): string {
    let result = "";
    for arg of args {
        result = result + arg;
    }
    return result;
}

/**
 * Formats a template string with values.
 * Template uses {0}, {1}, etc. for positional placeholders.
 * @param template Template string
 * @param values Values to substitute
 * @return Formatted string
 */
export fn template(templateStr: string, values: Array<dyn>): string {
    let result = templateStr;
    let i = 0;
    while (i < values.length()) {
        let placeholder = "{" + i + "}";
        let value = values[i];
        result = __string_replace_all(result, placeholder, value.toString());
        i = i + 1;
    }
    return result;
}

/**
 * Processes template literal expressions.
 * Used internally for ${...} substitutions.
 * @param parts Template parts array
 * @param context Evaluation context
 * @return Processed string
 */
export fn processTemplate(parts: Array<dyn>, context: dyn): string {
    let result = "";
    for part of parts {
        if (__string_length(part.toString()) > 0) {
            result = result + part.toString();
        }
    }
    return result;
}
