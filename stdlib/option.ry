/**
 * Ruyi Standard Library - Option Type
 *
 * Provides the Option type for handling potentially missing values.
 * Uses union type pattern with Some/None classes per spec 3.3.6.
 *
 * @author Ruyi Team
 * @date 2026-05-06
 */

/**
 * Some variant — contains a value.
 */
export class Some<T> {
    value: T;

    /**
     * Creates a new Some instance wrapping the given value.
     * @param value The value to wrap
     */
    fn new(value: T) {
        self.value = value;
    }

    /**
     * Checks if the option contains a value.
     * @return Always true for Some
     */
    fn isSome(): bool {
        return true;
    }

    /**
     * Checks if the option is empty.
     * @return Always false for Some
     */
    fn isNone(): bool {
        return false;
    }

    /**
     * Returns the contained value.
     * @return The contained value
     */
    fn unwrap(): T {
        return self.value;
    }

    /**
     * Returns the contained value or a provided default.
     * @param default The default value to return if empty
     * @return The contained value
     */
    fn unwrapOr(default: T): T {
        return self.value;
    }

    /**
     * Returns the contained value or computes one from a closure.
     * @param f The function to compute default value
     * @return The contained value
     */
    fn unwrapOrElse(f: fn() -> T): T {
        return self.value;
    }

    /**
     * Maps the contained value using the provided function.
     * @param f The transformation function (T -> U)
     * @return Some containing transformed value
     */
    fn map<U>(f: fn(T) -> U): Option<U> {
        return Some.new(f(self.value));
    }

    /**
     * Chains computations that may fail.
     * @param f The function to chain (T -> Option<U>)
     * @return Result of the function
     */
    fn andThen<U>(f: fn(T) -> Option<U>): Option<U> {
        return f(self.value);
    }

    /**
     * Returns Some if the predicate returns true, otherwise None.
     * @param pred The predicate function (T -> bool)
     * @return Some if predicate is true, else None
     */
    fn filter(pred: fn(T) -> bool): Option<T> {
        if (pred(self.value)) {
            return self;
        }
        return None.new();
    }

    /**
     * Flattens nested Options.
     * For Some(Option<T>), returns the inner Option.
     * @return The inner Option
     */
    fn flatten<U>(): Option<U> {
        return self.value;
    }

    /**
     * Converts to a Result, mapping None to Err.
     * @param err The error value for None case (unused for Some)
     * @return Ok with the contained value
     */
    fn okOr<E>(err: E): Result<T, E> {
        return Ok.new(self.value);
    }

    /**
     * Converts to a Result, mapping None to computed error.
     * @param f Function to compute error value (unused for Some)
     * @return Ok with the contained value
     */
    fn okOrElse<E>(f: fn() -> E): Result<T, E> {
        return Ok.new(self.value);
    }

    /**
     * Iterates over the contained value.
     * @param f The function to apply to the value
     */
    fn forEach(f: fn(T) -> void): void {
        f(self.value);
    }

    /**
     * Returns the contained value as a string.
     * @return "Some(value)"
     */
    fn toString(): string {
        return "Some(" + self.value.toString() + ")";
    }
}

/**
 * None variant — represents no value.
 * All methods that return a value either provide a default, compute one,
 * or throw. Methods that return Option or Result propagate the None/Err.
 */
export class None {
    /**
     * Creates a new None instance.
     */
    fn new() { }

    /**
     * Checks if the option contains a value.
     * @return Always false for None
     */
    fn isSome(): bool {
        return false;
    }

    /**
     * Checks if the option is empty.
     * @return Always true for None
     */
    fn isNone(): bool {
        return true;
    }

    /**
     * Panics because None has no value.
     * @return Never returns
     */
    fn unwrap(): never {
        throw RuntimeError("Called unwrap() on None");
    }

    /**
     * Returns the provided default value.
     * @param default The default value to return
     * @return The default value
     */
    fn unwrapOr<T>(default: T): T {
        return default;
    }

    /**
     * Computes and returns a value from the closure.
     * @param f The function to compute default value (() -> T)
     * @return The computed default
     */
    fn unwrapOrElse<T>(f: fn() -> T): T {
        return f();
    }

    /**
     * Maps the contained value (does nothing, always None).
     * @param f The transformation function (not called)
     * @return None
     */
    fn map<T, U>(f: fn(T) -> U): Option<U> {
        return None.new();
    }

    /**
     * Chains computations (does nothing, always None).
     * @param f The function to chain (not called)
     * @return None
     */
    fn andThen<T, U>(f: fn(T) -> Option<U>): Option<U> {
        return None.new();
    }

    /**
     * Returns None — predicate has no value to test.
     * @param pred The predicate function (not called)
     * @return None
     */
    fn filter<T>(pred: fn(T) -> bool): Option<T> {
        return None.new();
    }

    /**
     * Flattens nested Options. Always returns None.
     * @return None
     */
    fn flatten<U>(): Option<U> {
        return None.new();
    }

    /**
     * Converts to a Result, mapping None to Err.
     * @param err The error value
     * @return Err with the provided error
     */
    fn okOr<T, E>(err: E): Result<T, E> {
        return Err.new(err);
    }

    /**
     * Converts to a Result, mapping None to computed error.
     * @param f Function to compute error value (() -> E)
     * @return Err with computed error
     */
    fn okOrElse<T, E>(f: fn() -> E): Result<T, E> {
        return Err.new(f());
    }

    /**
     * Iterates over the contained value (does nothing).
     * @param f The function to apply (not called)
     */
    fn forEach<T>(f: fn(T) -> void): void { }

    /**
     * Returns the string representation.
     * @return "None"
     */
    fn toString(): string {
        return "None";
    }
}

/**
 * Option type alias — represents either a Some value or None.
 */
export type Option<T> = Some<T> | None;
