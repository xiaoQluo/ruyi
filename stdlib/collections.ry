/**
 * Ruyi Standard Library - Collections
 *
 * Provides generic collection types and traits:
 * - Array<T> extension via ArrayOps trait (auto-loaded)
 * - Map<K, V> class
 * - Set<T> class
 * - Iterator<T> trait
 *
 * @author Ruyi Team
 * @date 2026-05-05
 */

// ============================================================
// Iterator Trait
// ============================================================

/**
 * Iterator trait for collection traversal.
 * Provides a standard interface for iterating over elements.
 */
export trait Iterator<T> {
    /**
     * Returns the next element in the iterator.
     * @return The next element, or null if exhausted
     */
    fn next(self): T?;
}

// ============================================================
// Array Extension Trait
// ============================================================

/**
 * Array type operations trait.
 * Extends the built-in Array<T> with dynamic array methods.
 * This trait is automatically implemented for all Array<T> instances.
 */
export trait ArrayOps<T> {
    /**
     * Returns the number of elements in the array.
     * @return Array length
     */
    fn length(self): int;

    /**
     * Returns the element at the specified index.
     * @param index Element index
     * @return Element at index
     */
    fn get(self, index: int): T;

    /**
     * Sets the element at the specified index.
     * @param index Element index
     * @param value New value
     */
    fn set(self, index: int, value: T): void;

    /**
     * Adds an element to the end of the array.
     * @param value Element to add
     * @return The array (possibly reallocated)
     */
    fn push(self, value: T): Array<T>;

    /**
     * Removes and returns the last element.
     * @return Last element
     */
    fn pop(self): T;

    /**
     * Returns a new array with elements transformed by the function.
     * @param f Transformation function
     * @return New array with transformed elements
     */
    fn map<U>(self, f: fn(T) -> U): Array<U>;

    /**
     * Returns a new array with elements that satisfy the predicate.
     * @param pred Predicate function
     * @return Filtered array
     */
    fn filter(self, pred: fn(T) -> bool): Array<T>;

    /**
     * Reduces the array to a single value.
     * @param init Initial accumulator value
     * @param f Reduction function
     * @return Reduced value
     */
    fn reduce<U>(self, init: U, f: fn(U, T) -> U): U;

    /**
     * Applies a function to each element.
     * @param f Function to apply
     */
    fn forEach(self, f: fn(T) -> void): void;

    /**
     * Creates an iterator over the array elements.
     * @return Array iterator
     */
    fn iter(self): ArrayIterator<T>;
}

impl<T> ArrayOps<T> for Array<T> {
    fn length(self): int {
        return __builtin_array_length(self);
    }

    fn get(self, index: int): T {
        if (index < 0 || index >= __builtin_array_length(self)) {
            throw RangeError("Array index out of bounds: " + index.toString());
        }
        return __builtin_array_get(self, index);
    }

    fn set(self, index: int, value: T): void {
        if (index < 0 || index >= __builtin_array_length(self)) {
            throw RangeError("Array index out of bounds: " + index.toString());
        }
        __builtin_array_set(self, index, value);
    }

    fn push(self, value: T): Array<T> {
        return __builtin_array_push(self, value);
    }

    fn pop(self): T {
        if (__builtin_array_length(self) === 0) {
            throw RangeError("Cannot pop from empty array");
        }
        return __builtin_array_pop(self);
    }

    fn map<U>(self, f: fn(T) -> U): Array<U> {
        let result: Array<U> = [];
        let len = __builtin_array_length(self);
        let i = 0;
        while (i < len) {
            result.push(f(__builtin_array_get(self, i)));
            i = i + 1;
        }
        return result;
    }

    fn filter(self, pred: fn(T) -> bool): Array<T> {
        let result: Array<T> = [];
        let len = __builtin_array_length(self);
        let i = 0;
        while (i < len) {
            let elem = __builtin_array_get(self, i);
            if (pred(elem)) {
                result.push(elem);
            }
            i = i + 1;
        }
        return result;
    }

    fn reduce<U>(self, init: U, f: fn(U, T) -> U): U {
        let acc = init;
        let len = __builtin_array_length(self);
        let i = 0;
        while (i < len) {
            acc = f(acc, __builtin_array_get(self, i));
            i = i + 1;
        }
        return acc;
    }

    fn forEach(self, f: fn(T) -> void): void {
        let len = __builtin_array_length(self);
        let i = 0;
        while (i < len) {
            f(__builtin_array_get(self, i));
            i = i + 1;
        }
    }

    fn iter(self): ArrayIterator<T> {
        return ArrayIterator.new(self);
    }
}

// ============================================================
// Array Iterator
// ============================================================

/**
 * Iterator implementation for Array.
 */
export class ArrayIterator<T> {
    _array: Array<T>;
    _index: int;

    /**
     * Creates a new array iterator.
     * @param arr Array to iterate over
     */
    fn new(arr: Array<T>) {
        self._array = arr;
        self._index = 0;
    }

    /**
     * Returns the next element.
     * @return Next element, or null if exhausted
     */
    fn next(self): T? {
        if (self._index < __builtin_array_length(self._array)) {
            let elem = __builtin_array_get(self._array, self._index);
            self._index = self._index + 1;
            return elem;
        }
        return null;
    }
}

// ============================================================
// Map
// ============================================================

/**
 * Key-value map implementation with generic type parameters.
 */
export class Map<K, V> {
    _data: int;
    _size: int;
    _keys: Array<K>;

    /**
     * Creates a new empty map.
     */
    fn new() {
        self._data = __builtin_map_create();
        self._size = 0;
        self._keys = [];
    }

    /**
     * Returns the number of entries in the map.
     */
    fn size(self): int {
        return self._size;
    }

    /**
     * Returns the value associated with the key.
     * @param key Key to look up
     * @return Value wrapped in Option, or None if not found
     */
    fn get(self, key: K): V? {
        if (!self.has(key)) { return null; } return __builtin_map_get(self._data, key);
    }

    /**
     * Sets the value for the key.
     * @param key Key to set
     * @param value Value to associate
     */
    fn set(self, key: K, value: V): void {
        let existed = self.has(key);
        __builtin_map_set(self._data, key, value);
        if (!existed) {
            self._size = self._size + 1;
            self._keys = __builtin_array_push(self._keys, key);
        }
    }

    /**
     * Deletes the entry for the key.
     * @param key Key to delete
     * @return true if the key existed
     */
    fn delete(self, key: K): bool {
        let existed = self.has(key);
        __builtin_map_delete(self._data, key);
        if (existed) {
            self._size = self._size - 1;
            let i = 0;
            let len = __builtin_array_length(self._keys);
            while (i < len) {
                if (__builtin_array_get(self._keys, i) === key) {
                    let lastIdx = __builtin_array_length(self._keys) - 1;
                    __builtin_array_set(self._keys, i, __builtin_array_get(self._keys, lastIdx));
                    __builtin_array_pop(self._keys);
                    break;
                }
                i = i + 1;
            }
        }
        return existed;
    }

    /**
     * Checks if the map contains the key.
     * @param key Key to check
     * @return true if key exists
     */
    fn has(self, key: K): bool {
        return __builtin_map_has(self._data, key);
    }

    /**
     * Returns all keys in the map.
     * @return Array of keys
     */
    fn keys(self): Array<K> {
        return __builtin_map_keys(self._data);
    }

    /**
     * Returns all values in the map.
     * @return Array of values
     */
    fn values(self): Array<V> {
        return __builtin_map_values(self._data);
    }

    /**
     * Creates an iterator over the map entries.
     * @return Map iterator
     */
    fn iter(self): MapIterator<K, V> {
        return MapIterator.new(self);
    }
}

/**
 * Iterator implementation for Map.
 * Iterates over key-value pairs.
 */
export class MapIterator<K, V> {
    _map: Map<K, V>;
    _index: int;

    fn new(m: Map<K, V>) {
        self._map = m;
        self._index = 0;
    }

    fn next(self): { key: K, value: V }? {
        let mapKeys = self._map._keys;
        let mapData = self._map._data;
        if (self._index < __builtin_array_length(mapKeys)) {
            let key = __builtin_array_get(mapKeys, self._index);
            let value = __builtin_map_get(mapData, key);
            self._index = self._index + 1;
            return { key: key, value: value };
        }
        return null;
    }
}

// ============================================================
// Set
// ============================================================

/**
 * Set implementation with generic type parameter.
 */
export class Set<T> {
    _data: int;
    _size: int;
    _elements: Array<T>;

    /**
     * Creates a new empty set.
     */
    fn new() {
        self._data = __builtin_set_create();
        self._size = 0;
        self._elements = [];
    }

    /**
     * Returns the number of elements in the set.
     */
    fn size(self): int {
        return self._size;
    }

    /**
     * Adds an element to the set.
     * @param value Element to add
     */
    fn add(self, value: T): void {
        if (!self.has(value)) {
            __builtin_set_add(self._data, value);
            self._size = self._size + 1;
            self._elements = __builtin_array_push(self._elements, value);
        }
    }

    /**
     * Deletes an element from the set.
     * @param value Element to delete
     * @return true if the element existed
     */
    fn delete(self, value: T): bool {
        let existed = self.has(value);
        if (existed) {
            __builtin_set_delete(self._data, value);
            self._size = self._size - 1;
            let i = 0;
            let len = __builtin_array_length(self._elements);
            while (i < len) {
                if (__builtin_array_get(self._elements, i) === value) {
                    let lastIdx = __builtin_array_length(self._elements) - 1;
                    __builtin_array_set(self._elements, i, __builtin_array_get(self._elements, lastIdx));
                    __builtin_array_pop(self._elements);
                    break;
                }
                i = i + 1;
            }
        }
        return existed;
    }

    /**
     * Checks if the set contains the element.
     * @param value Element to check
     * @return true if element exists
     */
    fn has(self, value: T): bool {
        return __builtin_set_has(self._data, value);
    }

    /**
     * Creates an iterator over the set elements.
     * @return Set iterator
     */
    fn iter(self): SetIterator<T> {
        return SetIterator.new(self);
    }

    /**
     * Returns all elements in the set as an array.
     * @return Array of elements
     */
    fn toArray(self): Array<T> {
        let result: Array<T> = [];
        let iter = self.iter();
        while (true) {
            let elem = iter.next();
            if (elem === null) {
                break;
            }
            result.push(elem!);
        }
        return result;
    }
}

/**
 * Iterator implementation for Set.
 */
export class SetIterator<T> {
    _set: Set<T>;
    _index: int;

    fn new(s: Set<T>) {
        self._set = s;
        self._index = 0;
    }

    fn next(self): T? {
        let setElements = self._set._elements;
        if (self._index < __builtin_array_length(setElements)) {
            let elem = __builtin_array_get(setElements, self._index);
            self._index = self._index + 1;
            return elem;
        }
        return null;
    }
}
