/**
 * Iterator trait for collection traversal.
 * Provides a standard interface for iterating over elements.
 */
trait Iterator<T> {
    /**
     * Returns the next element in the iterator.
     * @return Option containing Some(element) or None if exhausted
     */
    fn next(self): Option<T>;

    /**
     * Applies a function to each element.
     * @param f The function to apply
     */
    fn forEach(self, f: fn(T): void): void {
        let mut iter = self;
        loop {
            match iter.next() {
                Some(element) => f(element),
                None => break
            }
        }
    }

    /**
     * Maps each element to a new value.
     * @param f The transformation function
     * @return Iterator over transformed values
     */
    fn map<U>(self, f: fn(T): U): Iterator<U> {
        return MapIterator { source: self, transform: f };
    }

    /**
     * Filters elements based on a predicate.
     * @param pred The predicate function
     * @return Iterator over elements that satisfy the predicate
     */
    fn filter(self, pred: fn(T): bool): Iterator<T> {
        return FilterIterator { source: self, predicate: pred };
    }

    /**
     * Reduces elements to a single value.
     * @param init Initial accumulator value
     * @param f The reduction function
     * @return The final accumulated value
     */
    fn reduce<U>(self, init: U, f: fn(U, T): U): U {
        let mut result = init;
        let mut iter = self;
        loop {
            match iter.next() {
                Some(element) => result = f(result, element),
                None => break
            }
        }
        return result;
    }
}

/**
 * Internal iterator adapter for map transformation.
 */
class MapIterator<T, U> {
    let source: Iterator<T>;
    let transform: fn(T): U;

    fn next(self): Option<U> {
        match self.source.next() {
            Some(element) => Some(self.transform(element)),
            None => None
        }
    }
}

/**
 * Internal iterator adapter for filter operation.
 */
class FilterIterator<T> {
    let source: Iterator<T>;
    let predicate: fn(T): bool;

    fn next(self): Option<T> {
        loop {
            match self.source.next() {
                Some(element) => {
                    if self.predicate(element) {
                        return Some(element);
                    }
                },
                None => return None
            }
        }
    }
}

/**
 * Dynamic array implementation with generic type parameter.
 * Provides methods for adding, removing, and accessing elements.
 */
class Array<T> {
    let mut elements: Array<T>;
    let mut length: int;

    /**
     * Creates a new empty array.
     */
    constructor() {
        this.elements = [];
        this.length = 0;
    }

    /**
     * Returns the number of elements in the array.
     * @return The length
     */
    fn get_length(self): int {
        return self.length;
    }

    /**
     * Returns the element at the specified index.
     * @param index The index
     * @return The element at index
     */
    fn get(self, index: int): T {
        if index < 0 or index >= self.length {
            throw RangeError("Array index out of bounds: " + index.toString());
        }
        return __builtin_array_get(self.elements, index);
    }

    /**
     * Sets the element at the specified index.
     * @param index The index
     * @param value The new value
     */
    fn set(self, index: int, value: T): void {
        if index < 0 or index >= self.length {
            throw RangeError("Array index out of bounds: " + index.toString());
        }
        __builtin_array_set(self.elements, index, value);
    }

    /**
     * Adds an element to the end of the array.
     * @param value The element to add
     */
    fn push(self, value: T): void {
        __builtin_array_push(self.elements, value);
        self.length = self.length + 1;
    }

    /**
     * Removes and returns the last element.
     * @return The last element
     */
    fn pop(self): T {
        if self.length == 0 {
            throw RangeError("Cannot pop from empty array");
        }
        self.length = self.length - 1;
        return __builtin_array_pop(self.elements);
    }

    /**
     * Returns a new array with elements transformed by the function.
     * @param f The transformation function
     * @return New array of transformed elements
     */
    fn map<U>(self, f: fn(T): U): Array<U> {
        let result = Array<U>();
        for (let i = 0; i < self.length; i = i + 1) {
            result.push(f(__builtin_array_get(self.elements, i)));
        }
        return result;
    }

    /**
     * Returns a new array with elements that satisfy the predicate.
     * @param pred The predicate function
     * @return New array of filtered elements
     */
    fn filter(self, pred: fn(T): bool): Array<T> {
        let result = Array<T>();
        for (let i = 0; i < self.length; i = i + 1) {
            let element = __builtin_array_get(self.elements, i);
            if pred(element) {
                result.push(element);
            }
        }
        return result;
    }

    /**
     * Reduces the array to a single value.
     * @param init Initial accumulator value
     * @param f The reduction function
     * @return The final accumulated value
     */
    fn reduce<U>(self, init: U, f: fn(U, T): U): U {
        let mut result = init;
        for (let i = 0; i < self.length; i = i + 1) {
            result = f(result, __builtin_array_get(self.elements, i));
        }
        return result;
    }

    /**
     * Applies a function to each element.
     * @param f The function to apply
     */
    fn forEach(self, f: fn(T): void): void {
        for (let i = 0; i < self.length; i = i + 1) {
            f(__builtin_array_get(self.elements, i));
        }
    }

    /**
     * Creates an iterator over the array elements.
     * @return Iterator for the array
     */
    fn iter(self): ArrayIterator<T> {
        return ArrayIterator { array: self, index: 0 };
    }
}

/**
 * Iterator implementation for Array.
 */
class ArrayIterator<T> {
    let array: Array<T>;
    let mut index: int;

    fn next(self): Option<T> {
        if self.index < array.length {
            let element = __builtin_array_get(self.array.elements, self.index);
            self.index = self.index + 1;
            return Some(element);
        }
        return None;
    }
}

/**
 * Key-value map implementation with generic type parameters.
 * Provides methods for adding, removing, and accessing entries.
 */
class Map<K, V> {
    let mut entries: Map<K, V>;
    let mut size: int;

    /**
     * Creates a new empty map.
     */
    constructor() {
        this.entries = __builtin_map_create();
        this.size = 0;
    }

    /**
     * Returns the number of entries in the map.
     * @return The size
     */
    fn get_size(self): int {
        return self.size;
    }

    /**
     * Returns the value associated with the key.
     * @param key The key
     * @return Option containing the value or None
     */
    fn get(self, key: K): Option<V> {
        return __builtin_map_get(self.entries, key);
    }

    /**
     * Sets the value for the key.
     * @param key The key
     * @param value The value
     */
    fn set(self, key: K, value: V): void {
        let was_empty = __builtin_map_get(self.entries, key).isNone();
        __builtin_map_set(self.entries, key, value);
        if was_empty {
            this.size = this.size + 1;
        }
    }

    /**
     * Deletes the entry for the key.
     * @param key The key
     * @return True if the key was deleted
     */
    fn delete(self, key: K): bool {
        let existed = __builtin_map_get(self.entries, key).isSome();
        __builtin_map_delete(self.entries, key);
        if existed {
            this.size = this.size - 1;
        }
        return existed;
    }

    /**
     * Checks if the map contains the key.
     * @param key The key
     * @return True if the key exists
     */
    fn has(self, key: K): bool {
        return __builtin_map_has(self.entries, key);
    }

    /**
     * Returns all keys in the map.
     * @return Array of keys
     */
    fn keys(self): Array<K> {
        return __builtin_map_keys(self.entries);
    }

    /**
     * Returns all values in the map.
     * @return Array of values
     */
    fn values(self): Array<V> {
        return __builtin_map_values(self.entries);
    }

    /**
     * Returns all key-value pairs as entries.
     * @return Array of [key, value] tuples
     */
    fn entries(self): Array<[K, V]> {
        return __builtin_map_entries(self.entries);
    }

    /**
     * Creates an iterator over the map entries.
     * @return Iterator for the map
     */
    fn iter(self): MapIterator<K, V> {
        return MapIterator { map: self, keys: self.keys(), index: 0 };
    }
}

/**
 * Iterator implementation for Map.
 */
class MapIterator<K, V> {
    let map: Map<K, V>;
    let keys: Array<K>;
    let mut index: int;

    fn next(self): Option<[K, V]> {
        if self.index < self.keys.length {
            let key = __builtin_array_get(self.keys, self.index);
            self.index = self.index + 1;
            match self.map.get(key) {
                Some(value) => return Some([key, value]),
                None => return None
            }
        }
        return None;
    }
}

/**
 * Set implementation with generic type parameter.
 * Provides methods for set operations like union, intersection, difference.
 */
class Set<T> {
    let mut entries: Set<T>;
    let mut size: int;

    /**
     * Creates a new empty set.
     */
    constructor() {
        this.entries = __builtin_set_create();
        this.size = 0;
    }

    /**
     * Returns the number of elements in the set.
     * @return The size
     */
    fn get_size(self): int {
        return self.size;
    }

    /**
     * Adds an element to the set.
     * @param value The element to add
     */
    fn add(self, value: T): void {
        let was_empty = not self.has(value);
        __builtin_set_add(self.entries, value);
        if was_empty {
            this.size = this.size + 1;
        }
    }

    /**
     * Deletes an element from the set.
     * @param value The element to delete
     * @return True if the element was deleted
     */
    fn delete(self, value: T): bool {
        let existed = self.has(value);
        __builtin_set_delete(self.entries, value);
        if existed {
            this.size = this.size - 1;
        }
        return existed;
    }

    /**
     * Checks if the set contains the element.
     * @param value The element to check
     * @return True if the element exists
     */
    fn has(self, value: T): bool {
        return __builtin_set_has(self.entries, value);
    }

    /**
     * Returns the union of this set and another.
     * @param other The other set
     * @return New set containing all elements
     */
    fn union(self, other: Set<T>): Set<T> {
        let result = Set<T>();
        // Add all elements from this set
        let iter = self.iter();
        loop {
            match iter.next() {
                Some(element) => result.add(element),
                None => break
            }
        }
        // Add all elements from other set
        let iter = other.iter();
        loop {
            match iter.next() {
                Some(element) => result.add(element),
                None => break
            }
        }
        return result;
    }

    /**
     * Returns the intersection of this set and another.
     * @param other The other set
     * @return New set containing common elements
     */
    fn intersection(self, other: Set<T>): Set<T> {
        let result = Set<T>();
        let iter = self.iter();
        loop {
            match iter.next() {
                Some(element) => {
                    if other.has(element) {
                        result.add(element);
                    }
                },
                None => break
            }
        }
        return result;
    }

    /**
     * Returns the difference of this set and another.
     * @param other The other set
     * @return New set containing elements in this but not other
     */
    fn difference(self, other: Set<T>): Set<T> {
        let result = Set<T>();
        let iter = self.iter();
        loop {
            match iter.next() {
                Some(element) => {
                    if not other.has(element) {
                        result.add(element);
                    }
                },
                None => break
            }
        }
        return result;
    }

    /**
     * Creates an iterator over the set elements.
     * @return Iterator for the set
     */
    fn iter(self): SetIterator<T> {
        return SetIterator { set: self, items: self.entries, index: 0 };
    }
}

/**
 * Iterator implementation for Set.
 * Note: The actual implementation depends on internal set representation.
 */
class SetIterator<T> {
    let set: Set<T>;
    let items: Set<T>;
    let mut index: int;

    fn next(self): Option<T> {
        // This is a placeholder - actual implementation would
        // iterate through internal set storage
        return None;
    }
}