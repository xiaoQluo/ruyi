/**
 * Ruyi Standard Library - Collections
 *
 * Provides generic collection types and traits:
 * - Array<T> extension via ArrayOps trait (auto-loaded)
 * - Map<K, V> class
 * - Set<T> class
 * - Iterator<T> trait
 * - Add / Mul numeric traits (Spec 4.9)
 *
 * @author Ruyi Team
 * @date 2026-05-05
 */

import { quickSort } from "./sort";

// Type aliases to work around the `>>` lexer tokenisation bug.
// Without these, `Iterator<Pair<int, T>>` is tokenised as
// `Iterator<Pair<int, T` followed by `>>` (right-shift).
type EnumPair<T> = Pair<int, T>;
type ZipPair<T> = Pair<T, T>;

// ============================================================
// Numeric Operator Traits (Spec 4.9)
// ============================================================

/**
 * Binary addition operator trait. Implementing types MUST define how
 * `self + other` (i.e. `self.add(other)`) is computed. The trait is
 * intentionally cycle-free: it has no supertraits, so its declaration
 * is guarded by the Batch 1.1 supertrait transitive cycle detector
 * without risk of participating in any chain.
 */
export trait Add {
    /**
     * Returns `self + other`.
     * @param other The right-hand operand
     * @return self + other
     */
    fn add(self, other: Self): Self;
}

/**
 * Binary multiplication operator trait. Pair with `Add` to enable the
 * `sum` / `product` reductions on `Array<T>` and `Iterator<T>`.
 */
export trait Mul {
    /**
     * Returns `self * other`.
     * @param other The right-hand operand
     * @return self * other
     */
    fn mul(self, other: Self): Self;
}

impl Add for int {
    fn add(self, other: int): int {
        return self + other;
    }
}

impl Mul for int {
    fn mul(self, other: int): int {
        return self * other;
    }
}

impl Add for float {
    fn add(self, other: float): float {
        return self + other;
    }
}

impl Mul for float {
    fn mul(self, other: float): float {
        return self * other;
    }
}

// ============================================================
// Iterator Trait
// ============================================================

/**
 * Iterator trait for collection traversal.
 * Provides a standard interface for iterating over elements.
 */
export trait Iterator<T> {
    /**
     * Returns the next element in the iterator.
     * @return The next element, or null if exhausted
     */
    fn next(self): T?;
}

// ============================================================
// Array Extension Trait
// ============================================================

/**
 * Array type operations trait.
 * Extends the built-in Array<T> with dynamic array methods.
 * This trait is automatically implemented for all Array<T> instances.
 */
export trait ArrayOps<T> {
    /**
     * Returns the number of elements in the array.
     * @return Array length
     */
    fn length(self): int;

    /**
     * Returns the element at the specified index.
     * @param index Element index
     * @return Element at index
     */
    fn get(self, index: int): T;

    /**
     * Sets the element at the specified index.
     * @param index Element index
     * @param value New value
     */
    fn set(self, index: int, value: T): void;

    /**
     * Adds an element to the end of the array.
     * @param value Element to add
     * @return The array (possibly reallocated)
     */
    fn push(self, value: T): Array<T>;

    /**
     * Removes and returns the last element.
     * @return Last element
     */
    fn pop(self): T;

    /**
     * Returns a new array with elements transformed by the function.
     * @param f Transformation function
     * @return New array with transformed elements
     */
    fn map<U>(self, f: fn(T) -> U): Array<U>;

    /**
     * Returns a new array with elements that satisfy the predicate.
     * @param pred Predicate function
     * @return Filtered array
     */
    fn filter(self, pred: fn(T) -> bool): Array<T>;

    /**
     * Reduces the array to a single value.
     * @param init Initial accumulator value
     * @param f Reduction function
     * @return Reduced value
     */
    fn reduce<U>(self, init: U, f: fn(U, T) -> U): U;

    /**
     * Applies a function to each element.
     * @param f Function to apply
     */
    fn forEach(self, f: fn(T) -> void): void;

    /**
     * Checks if the array contains the specified value.
     * @param value Value to search for
     * @return true if the value is found in the array
     */
    fn contains(self, value: T): bool;

    /**
     * Creates an iterator over the array elements.
     * @return Array iterator
     */
    fn iter(self): ArrayIterator<T>;

    // ── Spec 4.9 extensions ───────────────────────────────────

    /**
     * Returns a new array with the elements sorted in ascending order
     * using the default strict-equals ordering. The receiver MUST NOT
     * be mutated.
     * @return A new ascending-sorted Array<T>
     */
    fn sort(self): Array<T>;

    /**
     * Returns the index of the first occurrence of `value` in the array,
     * or `-1` if the value is not present. Uses strict-equals semantics.
     * @param value Value to search for
     * @return First matching index, or -1
     */
    fn indexOf(self, value: T): int;

    /**
     * Returns the first element of the array, or `null` if the array is
     * empty. Pair with `last()` for two-end access.
     * @return First element, or null when empty
     */
    fn first(self): T?;

    /**
     * Returns the last element of the array, or `null` if the array is
     * empty. Pair with `first()` for two-end access.
     * @return Last element, or null when empty
     */
    fn last(self): T?;

    /**
     * Returns a new array containing the elements from `begin` (inclusive)
     * through `end` (exclusive). The receiver MUST NOT be mutated.
     * @param begin Start index (inclusive)
     * @param end End index (exclusive)
     * @return New Array<T> slice
     */
    fn slice(self, begin: int, end: int): Array<T>;

    /**
     * Returns a new array formed by concatenating `other` onto the end
     * of `self`. Neither input MUST be mutated.
     * @param other Array to append
     * @return New Array<T> containing both inputs
     */
    fn concat(self, other: Array<T>): Array<T>;
}

impl<T> ArrayOps<T> for Array<T> {
    fn length(self): int {
        return __builtin_array_length(self);
    }

    fn get(self, index: int): T {
        if (index < 0 || index >= __builtin_array_length(self)) {
            throw RangeError.new("Array index out of bounds: " + index.toString());
        }
        return __builtin_array_get(self, index);
    }

    fn set(self, index: int, value: T): void {
        if (index < 0 || index >= __builtin_array_length(self)) {
            throw RangeError.new("Array index out of bounds: " + index.toString());
        }
        __builtin_array_set(self, index, value);
    }

    fn push(self, value: T): Array<T> {
        return __builtin_array_push(self, value);
    }

    fn pop(self): T {
        if (__builtin_array_length(self) === 0) {
            throw RangeError.new("Cannot pop from empty array");
        }
        return __builtin_array_pop(self);
    }

    fn map<U>(self, f: fn(T) -> U): Array<U> {
        let result: Array<U> = [];
        let len = __builtin_array_length(self);
        let i = 0;
        while (i < len) {
            result.push(f(__builtin_array_get(self, i)));
            i = i + 1;
        }
        return result;
    }

    fn filter(self, pred: fn(T) -> bool): Array<T> {
        let result: Array<T> = [];
        let len = __builtin_array_length(self);
        let i = 0;
        while (i < len) {
            let elem = __builtin_array_get(self, i);
            if (pred(elem)) {
                result.push(elem);
            }
            i = i + 1;
        }
        return result;
    }

    fn reduce<U>(self, init: U, f: fn(U, T) -> U): U {
        let acc = init;
        let len = __builtin_array_length(self);
        let i = 0;
        while (i < len) {
            acc = f(acc, __builtin_array_get(self, i));
            i = i + 1;
        }
        return acc;
    }

    fn forEach(self, f: fn(T) -> void): void {
        let len = __builtin_array_length(self);
        let i = 0;
        while (i < len) {
            f(__builtin_array_get(self, i));
            i = i + 1;
        }
    }

    fn contains(self, value: T): bool {
        let len = __builtin_array_length(self);
        let i = 0;
        while (i < len) {
            if (__builtin_array_get(self, i) === value) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    fn iter(self): ArrayIterator<T> {
        return ArrayIterator.new(self);
    }

    // ── Spec 4.9 extensions ───────────────────────────────────

    /**
     * Insertion sort. The receiver is copied via `push` so the input
     * array is left untouched (the type checker infers a fresh local).
     */
    fn sort(self): Array<T> {
        return quickSort(self, (a, b) => {
            if (a > b) { return 1; }
            if (a < b) { return -1; }
            return 0;
        });
    }

    /**
     * Linear scan with strict-equals. Returns `-1` on miss.
     */
    fn indexOf(self, value: T): int {
        let len = __builtin_array_length(self);
        let i = 0;
        while (i < len) {
            if (__builtin_array_get(self, i) === value) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    fn first(self): T? {
        if (__builtin_array_length(self) === 0) {
            return null;
        }
        return __builtin_array_get(self, 0);
    }

    fn last(self): T? {
        let n = __builtin_array_length(self);
        if (n === 0) {
            return null;
        }
        return __builtin_array_get(self, n - 1);
    }

    fn slice(self, begin: int, end: int): Array<T> {
        let result: Array<T> = [];
        let i = begin;
        while (i < end) {
            result = __builtin_array_push(result, __builtin_array_get(self, i));
            i = i + 1;
        }
        return result;
    }

    fn concat(self, other: Array<T>): Array<T> {
        let result: Array<T> = [];
        let len = __builtin_array_length(self);
        let i = 0;
        while (i < len) {
            result = __builtin_array_push(result, __builtin_array_get(self, i));
            i = i + 1;
        }
        let otherLen = __builtin_array_length(other);
        let k = 0;
        while (k < otherLen) {
            result = __builtin_array_push(result, __builtin_array_get(other, k));
            k = k + 1;
        }
        return result;
    }
}

// ============================================================
// Array Iterator
// ============================================================

/**
 * Iterator implementation for Array.
 */
export class ArrayIterator<T> {
    _array: Array<T>;
    _index: int;

    /**
     * Creates a new array iterator.
     * @param arr Array to iterate over
     */
    fn new(arr: Array<T>) {
        self._array = arr;
        self._index = 0;
    }

    /**
     * Returns the next element.
     * @return Next element, or null if exhausted
     */
    fn next(self): T? {
        if (self._index < __builtin_array_length(self._array)) {
            let elem = __builtin_array_get(self._array, self._index);
            self._index = self._index + 1;
            return elem;
        }
        return null;
    }

    // ── Spec 4.9 Iterator extensions ──────────────────────────

    /**
     * Returns a new iterator that yields elements while `pred(elem)` is
     * true, stopping at the first false. Backed by a TakeWhileIterator
     * so the predicate is evaluated lazily.
     */
    fn takeWhile(self, pred: fn(T) -> bool): Iterator<T> {
        return TakeWhileIterator.new(self, pred);
    }

    /**
     * Returns a new iterator that skips elements while `pred(elem)` is
     * true and yields the remainder. Backed by a SkipWhileIterator.
     */
    fn skipWhile(self, pred: fn(T) -> bool): Iterator<T> {
        return SkipWhileIterator.new(self, pred);
    }

    /**
     * Returns a new iterator that yields elements of `self` followed by
     * elements of `other`. Backed by a ChainedIterator.
     */
    fn chain(self, other: Iterator<T>): Iterator<T> {
        return ChainedIterator.new(self, other);
    }

    /**
     * Returns a new iterator yielding `(index, value)` pairs.
     */
    fn enumerate(self): Iterator<EnumPair<T> > {
        return EnumeratedIterator.new(self, 0);
    }

    /**
     * Returns a new iterator yielding `(a, b)` pairs from `self` and
     * `other`. Stops at the shorter of the two sequences.
     */
    fn zip(self, other: Iterator<T>): Iterator<ZipPair<T> > {
        return ZippedIterator.new(self, other);
    }

    /**
     * Returns the running sum of the remaining elements. The element
     * type MUST implement `Add`. Mirrors `Array.sum()` over the rest
     * of the iterator.
     */
    fn sum(self): T {
        let total: T = __builtin_array_get(self._array, 0);
        let len = __builtin_array_length(self._array);
        let i = 1;
        while (i < len) {
            total = total.add(__builtin_array_get(self._array, i));
            i = i + 1;
        }
        return total;
    }

    /**
     * Returns the running product of the remaining elements. The element
     * type MUST implement `Mul`.
     */
    fn product(self): T {
        let total: T = __builtin_array_get(self._array, 0);
        let len = __builtin_array_length(self._array);
        let i = 1;
        while (i < len) {
            total = total.mul(__builtin_array_get(self._array, i));
            i = i + 1;
        }
        return total;
    }

    /**
     * Returns true as soon as any element satisfies `pred`. Short-circuit.
     */
    fn any(self, pred: fn(T) -> bool): bool {
        let len = __builtin_array_length(self._array);
        let i = 0;
        while (i < len) {
            if (pred(__builtin_array_get(self._array, i))) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    /**
     * Returns true iff every element satisfies `pred`. Short-circuit.
     */
    fn all(self, pred: fn(T) -> bool): bool {
        let len = __builtin_array_length(self._array);
        let i = 0;
        while (i < len) {
            if (!pred(__builtin_array_get(self._array, i))) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
}

impl<T> Iterator<T> for ArrayIterator<T> {}

// ============================================================
// Lazy Iterator Adapter Classes (Spec 4.9)
// ============================================================

/**
 * Iterator adapter that yields elements while the predicate is true.
 */
export class TakeWhileIterator<T> {
    _source: ArrayIterator<T>;
    _pred: fn(T) -> bool;

    fn new(source: ArrayIterator<T>, pred: fn(T) -> bool) {
        self._source = source;
        self._pred = pred;
    }

    fn next(self): T? {
        let v = self._source.next();
        if (v === null) {
            return null;
        }
        if (self._pred(v!)) {
            return v;
        }
        return null;
    }
}

impl<T> Iterator<T> for TakeWhileIterator<T> {}

/**
 * Iterator adapter that skips elements while the predicate is true.
 */
export class SkipWhileIterator<T> {
    _source: ArrayIterator<T>;
    _pred: fn(T) -> bool;
    _exhausted: bool;

    fn new(source: ArrayIterator<T>, pred: fn(T) -> bool) {
        self._source = source;
        self._pred = pred;
        self._exhausted = false;
    }

    fn next(self): T? {
        if (self._exhausted) {
            return self._source.next();
        }
        while (true) {
            let v = self._source.next();
            if (v === null) {
                self._exhausted = true;
                return null;
            }
            if (self._pred(v!)) {
                continue;
            }
            self._exhausted = true;
            return v;
        }
    }
}

impl<T> Iterator<T> for SkipWhileIterator<T> {}

/**
 * Iterator adapter that concatenates two iterators.
 */
export class ChainedIterator<T> {
    _first: ArrayIterator<T>;
    _second: Iterator<T>;
    _first_done: bool;

    fn new(first: ArrayIterator<T>, second: Iterator<T>) {
        self._first = first;
        self._second = second;
        self._first_done = false;
    }

    fn next(self): T? {
        if (!self._first_done) {
            let v = self._first.next();
            if (v !== null) {
                return v;
            }
            self._first_done = true;
        }
        return self._second.next();
    }
}

impl<T> Iterator<T> for ChainedIterator<T> {}

/**
 * Iterator adapter that yields `(index, value)` pairs.
 */
export class EnumeratedIterator<T> {
    _source: ArrayIterator<T>;
    _counter: int;

    fn new(source: ArrayIterator<T>, start: int) {
        self._source = source;
        self._counter = start;
    }

    fn next(self): Pair<int, T>? {
        let v = self._source.next();
        if (v === null) {
            return null;
        }
        let pair = { first: self._counter, second: v! };
        self._counter = self._counter + 1;
        return pair;
    }
}

impl<T> Iterator<EnumPair<T>> for EnumeratedIterator<T> {}

/**
 * Iterator adapter that zips two iterators into `(a, b)` pairs.
 */
export class ZippedIterator<T> {
    _first: ArrayIterator<T>;
    _second: Iterator<T>;

    fn new(first: ArrayIterator<T>, second: Iterator<T>) {
        self._first = first;
        self._second = second;
    }

    fn next(self): Pair<T, T>? {
        let a = self._first.next();
        if (a === null) {
            return null;
        }
        let b = self._second.next();
        if (b === null) {
            return null;
        }
        return { first: a!, second: b! };
    }
}

impl<T> Iterator<ZipPair<T>> for ZippedIterator<T> {}

// ============================================================
// Map
// ============================================================

/**
 * Key-value map implementation with generic type parameters.
 */
export class Map<K, V> {
    // Opaque handle to builtin map (managed by compiler runtime)
    _data: int;
    _size: int;
    _keys: Array<K>;

    /**
     * Creates a new empty map.
     */
    fn new() {
        self._data = __builtin_map_create();
        self._size = 0;
        self._keys = [];
    }

    /**
     * Returns the number of entries in the map.
     */
    fn size(self): int {
        return self._size;
    }

    /**
     * Returns the value associated with the key.
     * @param key Key to look up
     * @return The value, or null if key not found
     */
    fn get(self, key: K): V? {
        if (!self.has(key)) { return null; } return __builtin_map_get(self._data, key);
    }

    /**
     * Sets the value for the key.
     * @param key Key to set
     * @param value Value to associate
     */
    fn set(self, key: K, value: V): void {
        let existed = self.has(key);
        __builtin_map_set(self._data, key, value);
        if (!existed) {
            self._size = self._size + 1;
            self._keys = __builtin_array_push(self._keys, key);
        }
    }

    /**
     * Deletes the entry for the key.
     * @param key Key to delete
     * @return true if the key existed
     */
    fn delete(self, key: K): bool {
        let existed = self.has(key);
        __builtin_map_delete(self._data, key);
        if (existed) {
            self._size = self._size - 1;
            let i = 0;
            let len = __builtin_array_length(self._keys);
            while (i < len) {
                if (__builtin_array_get(self._keys, i) === key) {
                    let lastIdx = __builtin_array_length(self._keys) - 1;
                    __builtin_array_set(self._keys, i, __builtin_array_get(self._keys, lastIdx));
                    __builtin_array_pop(self._keys);
                    break;
                }
                i = i + 1;
            }
        }
        return existed;
    }

    /**
     * Checks if the map contains the key.
     * @param key Key to check
     * @return true if key exists
     */
    fn has(self, key: K): bool {
        return __builtin_map_has(self._data, key);
    }

    /**
     * Removes all entries from the map.
     */
    fn clear(self): void {
        self._data = __builtin_map_create();
        self._size = 0;
        self._keys = [];
    }

    /**
     * Returns all keys in the map.
     * @return Array of keys
     */
    fn keys(self): Array<K> {
        return __builtin_map_keys(self._data);
    }

    /**
     * Returns all values in the map.
     * @return Array of values
     */
    fn values(self): Array<V> {
        return __builtin_map_values(self._data);
    }

    /**
     * Creates an iterator over the map entries.
     * @return Map iterator
     */
    fn iter(self): MapIterator<K, V> {
        return MapIterator.new(self);
    }

    // ── Internal accessors (used by MapIterator) ──────────────

    fn _getRaw(self, key: K): V? {
        return __builtin_map_get(self._data, key);
    }
}

/**
 * Iterator implementation for Map.
 * Iterates over key-value pairs.
 */
export class MapIterator<K, V> {
    _map: Map<K, V>;
    _index: int;

    fn new(m: Map<K, V>) {
        self._map = m;
        self._index = 0;
    }

    fn next(self): { key: K, value: V }? {
        let mapKeys = self._map.keys();
        if (self._index < __builtin_array_length(mapKeys)) {
            let key = __builtin_array_get(mapKeys, self._index);
            let value = self._map._getRaw(key);
            self._index = self._index + 1;
            return { key: key, value: value };
        }
        return null;
    }
}

// ============================================================
// Set
// ============================================================

/**
 * Set implementation with generic type parameter.
 */
export class Set<T> {
    // Opaque handle to builtin set (managed by compiler runtime)
    _data: int;
    _size: int;
    _elements: Array<T>;

    /**
     * Creates a new empty set.
     */
    fn new() {
        self._data = __builtin_set_create();
        self._size = 0;
        self._elements = [];
    }

    /**
     * Returns the number of elements in the set.
     */
    fn size(self): int {
        return self._size;
    }

    /**
     * Adds an element to the set.
     * @param value Element to add
     */
    fn add(self, value: T): void {
        if (!self.has(value)) {
            __builtin_set_add(self._data, value);
            self._size = self._size + 1;
            self._elements = __builtin_array_push(self._elements, value);
        }
    }

    /**
     * Deletes an element from the set.
     * @param value Element to delete
     * @return true if the element existed
     */
    fn delete(self, value: T): bool {
        let existed = self.has(value);
        if (existed) {
            __builtin_set_delete(self._data, value);
            self._size = self._size - 1;
            let i = 0;
            let len = __builtin_array_length(self._elements);
            while (i < len) {
                if (__builtin_array_get(self._elements, i) === value) {
                    let lastIdx = __builtin_array_length(self._elements) - 1;
                    __builtin_array_set(self._elements, i, __builtin_array_get(self._elements, lastIdx));
                    __builtin_array_pop(self._elements);
                    break;
                }
                i = i + 1;
            }
        }
        return existed;
    }

    /**
     * Checks if the set contains the element.
     * @param value Element to check
     * @return true if element exists
     */
    fn has(self, value: T): bool {
        return __builtin_set_has(self._data, value);
    }

    /**
     * Removes all elements from the set.
     */
    fn clear(self): void {
        self._data = __builtin_set_create();
        self._size = 0;
        self._elements = [];
    }

    /**
     * Creates an iterator over the set elements.
     * @return Set iterator
     */
    fn iter(self): SetIterator<T> {
        return SetIterator.new(self);
    }

    // ── Internal accessor (used by SetIterator) ───────────────

    fn _elementsArray(self): Array<T> {
        return self._elements;
    }

    /**
     * Returns all elements in the set as an array.
     * @return Array of elements
     */
    fn toArray(self): Array<T> {
        let result: Array<T> = [];
        let iter = self.iter();
        while (true) {
            let elem = iter.next();
            if (elem === null) {
                break;
            }
            result.push(elem!);
        }
        return result;
    }
}

/**
 * Iterator implementation for Set.
 */
export class SetIterator<T> {
    _set: Set<T>;
    _index: int;

    fn new(s: Set<T>) {
        self._set = s;
        self._index = 0;
    }

    fn next(self): T? {
        let setElements = self._set._elementsArray();
        if (self._index < __builtin_array_length(setElements)) {
            let elem = __builtin_array_get(setElements, self._index);
            self._index = self._index + 1;
            return elem;
        }
        return null;
    }
}

impl<T> Iterator<T> for SetIterator<T> {}
