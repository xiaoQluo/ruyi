/**
 * Crypto CSPRNG sub-module — standalone cryptographically secure
 * random number generation functions.
 *
 * @author Ruyi Team
 * @date 2026-07-24
 */

import { bytesToHex } from "../encoding";
import { v4 as uuidV4 } from "../uuid";

// ============================================================
// CSPRNG — Cryptographically Secure Pseudorandom Number Generator
// ============================================================

/**
 * Generates `size` cryptographically secure random bytes.
 *
 * Uses the __io_read_random FFI function to obtain OS-provided
 * entropy. The returned buffer is a null-terminated C string;
 * bytes are extracted via charCodeAt and masked to 0-255.
 *
 * @param size Number of random bytes to generate
 * @return Array<byte> of cryptographically secure random bytes
 */
export fn cryptoRandomBytes(size: int): Array<byte> {
    if (size <= 0) {
        return [];
    }
    let buf = __io_read_random(size);
    let result: Array<byte> = [];
    let i = 0;
    while (i < size) {
        result.push(buf.charCodeAt(i));
        i = i + 1;
    }
    return result;
}

/**
 * Generates a cryptographically secure random hex string.
 *
 * @param size Number of random bytes (output is 2× size hex chars)
 * @return Lowercase hex-encoded random string
 */
export fn cryptoRandomHex(size: int): string {
    let bytes = cryptoRandomBytes(size);
    return bytesToHex(bytes);
}

/**
 * Generates a cryptographically secure random integer in the range
 * [min, max] inclusive. Uses rejection sampling to avoid modulo bias.
 *
 * @param min Minimum value (inclusive)
 * @param max Maximum value (inclusive)
 * @return Uniformly random integer in [min, max]
 */
export fn cryptoRandomInt(min: int, max: int): int {
    if (min === max) {
        return min;
    }
    if (min > max) {
        let tmp = min;
        min = max;
        max = tmp;
    }

    let range = max - min + 1;

    // Edge case: range could overflow if max=MAX_INT and min is negative.
    // For such large ranges, use a simpler approach.
    if (range <= 0) {
        // Generate 8 random bytes, combine into a 64-bit value,
        // then scale into the range using floating point.
        let bytes = cryptoRandomBytes(8);
        let i = 0;
        let val = 0;
        while (i < 8) {
            val = (val << 8) | bytes.get(i);
            i = i + 1;
        }
        // Use modulo as approximate uniform (good enough for range ~ 2^63)
        if (val < 0) {
            val = -val;
        }
        return min + (val % range);
    }

    // Rejection sampling for unbiased results
    // Find the largest multiple of `range` ≤ 256 (byte size)
    // For larger ranges, use 8 bytes
    let maxValid = 0;
    if (range <= 256) {
        // Use 1 byte, find maxValid = largest multiple of range ≤ 256
        maxValid = 256 - (256 % range);
        while (true) {
            let bytes = cryptoRandomBytes(1);
            let val = bytes.get(0);
            if (val < maxValid) {
                return min + (val % range);
            }
        }
    } else {
        // Use 8 bytes, compute maxValid
        // For practical ranges, just use modulo — the bias is negligible
        let bytes = cryptoRandomBytes(8);
        let i = 0;
        let val = 0;
        while (i < 8) {
            val = (val << 8) | bytes.get(i);
            i = i + 1;
        }
        if (val < 0) {
            val = -val;
        }
        return min + (val % range);
    }
}

/**
 * Generates a cryptographically secure random UUID (version 4).
 *
 * Delegates to uuid.v4() from stdlib/uuid.ry.
 * Both crypto.ry (via __io_read_random) and uuid.ry (via Random)
 * pull entropy from OS-level CSPRNG sources — the output is
 * functionally indistinguishable.
 *
 * @return Version 4 UUID string (36 characters, RFC 9562)
 */
export fn cryptoRandomUUID(): string {
    return uuidV4();
}
