/**
 * Ruyi Standard Library - Hash Algorithm Module
 *
 * Pure .ry implementations of standard hash algorithms.
 * Supported algorithms:
 *   - SHA-256 (RFC 6234) — 256-bit secure hash
 *   - SHA-512 (RFC 6234) — 512-bit secure hash
 *   - SHA-1   (RFC 3174) — 160-bit legacy hash
 *   - MD5     (RFC 1321) — 128-bit legacy hash
 *
 * This module is extracted from crypto.ry and provides standalone hash
 * implementations that can be imported by HMAC, PBKDF2, and other modules.
 *
 * Dependencies:
 *   - ../encoding: bytesToHex
 *   - ../string: fromCharCode
 *   - ./util: stringToBytes, zeroArray, copyArray, rotr32, rotr64, u64
 *
 * @author Ruyi Team
 * @date 2026-07-24
 */

import { bytesToHex } from "../encoding";
import { fromCharCode } from "../string";
import { stringToBytes, zeroArray, copyArray, rotr32, rotr64, u64 } from "./util";

// ============================================================
// SHA-2 Family Helpers
// ============================================================

/**
 * SHA-256 Σ0 (Sigma upper 0): rotr2(x) ^ rotr13(x) ^ rotr22(x)
 */
fn sha256_Sigma0(x: int): int {
    return rotr32(x, 2) ^ rotr32(x, 13) ^ rotr32(x, 22);
}

/**
 * SHA-256 Σ1 (Sigma upper 1): rotr6(x) ^ rotr11(x) ^ rotr25(x)
 */
fn sha256_Sigma1(x: int): int {
    return rotr32(x, 6) ^ rotr32(x, 11) ^ rotr32(x, 25);
}

/**
 * SHA-256 σ0 (Sigma lower 0): rotr7(x) ^ rotr18(x) ^ (x >>> 3)
 */
fn sha256_sigma0(x: int): int {
    return rotr32(x, 7) ^ rotr32(x, 18) ^ ((x & 0xFFFFFFFF) >>> 3);
}

/**
 * SHA-256 σ1 (Sigma lower 1): rotr17(x) ^ rotr19(x) ^ (x >>> 10)
 */
fn sha256_sigma1(x: int): int {
    return rotr32(x, 17) ^ rotr32(x, 19) ^ ((x & 0xFFFFFFFF) >>> 10);
}

/**
 * SHA-256 Ch(e, f, g): (e & f) ^ ((~e) & g)  [32-bit]
 */
fn sha256_ch(e: int, f: int, g: int): int {
    return (e & f) ^ (((~e) & 0xFFFFFFFF) & g);
}

/**
 * SHA-256 Maj(a, b, c): (a & b) ^ (a & c) ^ (b & c)  [32-bit]
 */
fn sha256_maj(a: int, b: int, c: int): int {
    return (a & b) ^ (a & c) ^ (b & c);
}

/**
 * SHA-512 Σ0 (Sigma upper 0): rotr28(x) ^ rotr34(x) ^ rotr39(x)
 */
fn sha512_Sigma0(x: int): int {
    return rotr64(x, 28) ^ rotr64(x, 34) ^ rotr64(x, 39);
}

/**
 * SHA-512 Σ1 (Sigma upper 1): rotr14(x) ^ rotr18(x) ^ rotr41(x)
 */
fn sha512_Sigma1(x: int): int {
    return rotr64(x, 14) ^ rotr64(x, 18) ^ rotr64(x, 41);
}

/**
 * SHA-512 σ0 (Sigma lower 0): rotr1(x) ^ rotr8(x) ^ (x >>> 7)
 */
fn sha512_sigma0(x: int): int {
    return rotr64(x, 1) ^ rotr64(x, 8) ^ (x >>> 7);
}

/**
 * SHA-512 σ1 (Sigma lower 1): rotr19(x) ^ rotr61(x) ^ (x >>> 6)
 */
fn sha512_sigma1(x: int): int {
    return rotr64(x, 19) ^ rotr64(x, 61) ^ (x >>> 6);
}

/**
 * SHA-512 Ch(e, f, g): (e & f) ^ ((~e) & g)  [64-bit]
 */
fn sha512_ch(e: int, f: int, g: int): int {
    return (e & f) ^ ((~e) & g);
}

/**
 * SHA-512 Maj(a, b, c): (a & b) ^ (a & c) ^ (b & c)  [64-bit]
 */
fn sha512_maj(a: int, b: int, c: int): int {
    return (a & b) ^ (a & c) ^ (b & c);
}

// ============================================================
// SHA-256 (RFC 6234)
// ============================================================

/**
 * SHA-256 K constants: first 32 bits of the fractional parts of the
 * cube roots of the first 64 primes (2..311).
 */
const SHA256_K: Array<int> = [
    0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5,
    0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
    0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3,
    0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174,
    0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC,
    0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
    0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7,
    0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967,
    0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13,
    0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85,
    0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3,
    0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
    0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5,
    0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3,
    0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208,
    0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2
];

/**
 * SHA-256 initial hash values: first 32 bits of the fractional parts
 * of the square roots of the first 8 primes (2, 3, 5, 7, 11, 13, 17, 19).
 */
const SHA256_H0: Array<int> = [
    0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A,
    0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19
];

/**
 * Pads input data for SHA-256 processing per RFC 6234.
 *
 * Appends a single '1' bit (0x80), pads with zeros until
 * length ≡ 448 (mod 512), then appends the 64-bit big-endian
 * original message length in bits.
 *
 * @param data Input byte array
 * @param bitLen Original message length in bits
 * @return Padded byte array with length a multiple of 64
 */
fn sha256_pad(data: Array<int>, bitLen: int): Array<int> {
    let padded: Array<int> = copyArray(data);
    // Append 0x80 (single '1' bit followed by 7 zero bits)
    padded.push(0x80);

    // Pad with zeros until length ≡ 56 (mod 64)
    // Target: (data length + 1 + padZeros + 8) % 64 == 0
    // So (data length + 1 + padZeros) % 64 == 56
    let currentLen = padded.length();
    while (currentLen % 64 !== 56) {
        padded.push(0);
        currentLen = currentLen + 1;
    }

    // Append 64-bit big-endian original message length in bits
    // Upper 32 bits first, then lower 32 bits
    padded.push((bitLen >> 56) & 0xFF);
    padded.push((bitLen >> 48) & 0xFF);
    padded.push((bitLen >> 40) & 0xFF);
    padded.push((bitLen >> 32) & 0xFF);
    padded.push((bitLen >> 24) & 0xFF);
    padded.push((bitLen >> 16) & 0xFF);
    padded.push((bitLen >> 8) & 0xFF);
    padded.push(bitLen & 0xFF);

    return padded;
}

/**
 * Processes a single 64-byte SHA-256 block (512 bits).
 *
 * Expands the 16 32-bit words into the 64-entry message schedule W,
 * then performs 64 rounds of compression updating the state hash.
 *
 * @param state Current 8-word hash state (modified in place)
 * @param block 64-byte block to process
 */
fn sha256_compress(state: Array<int>, block: Array<int>) {
    // Prepare 64-entry message schedule
    let w: Array<int> = zeroArray(64);

    // First 16 words: pack 4 bytes each big-endian from the block
    let j = 0;
    while (j < 16) {
        let offset = j * 4;
        w.set(j,
            ((block.get(offset) & 0xFF) << 24) |
            ((block.get(offset + 1) & 0xFF) << 16) |
            ((block.get(offset + 2) & 0xFF) << 8) |
            (block.get(offset + 3) & 0xFF)
        );
        j = j + 1;
    }

    // Extend to 64 words via message schedule
    j = 16;
    while (j < 64) {
        let s0 = sha256_sigma0(w.get(j - 15));
        let s1 = sha256_sigma1(w.get(j - 2));
        let val = ((w.get(j - 16) + s0 + w.get(j - 7)) & 0xFFFFFFFF);
        val = (val + s1) & 0xFFFFFFFF;
        w.set(j, val);
        j = j + 1;
    }

    // Initialize working variables from current state
    let a = state.get(0);
    let b = state.get(1);
    let c = state.get(2);
    let d = state.get(3);
    let e = state.get(4);
    let f = state.get(5);
    let g = state.get(6);
    let h = state.get(7);

    // 64 rounds of compression
    let round = 0;
    while (round < 64) {
        let t1 = h + sha256_Sigma1(e) + sha256_ch(e, f, g) + SHA256_K.get(round) + w.get(round);
        t1 = t1 & 0xFFFFFFFF;
        let t2 = sha256_Sigma0(a) + sha256_maj(a, b, c);
        t2 = t2 & 0xFFFFFFFF;

        h = g;
        g = f;
        f = e;
        e = (d + t1) & 0xFFFFFFFF;
        d = c;
        c = b;
        b = a;
        a = (t1 + t2) & 0xFFFFFFFF;

        round = round + 1;
    }

    // Update hash state
    state.set(0, (state.get(0) + a) & 0xFFFFFFFF);
    state.set(1, (state.get(1) + b) & 0xFFFFFFFF);
    state.set(2, (state.get(2) + c) & 0xFFFFFFFF);
    state.set(3, (state.get(3) + d) & 0xFFFFFFFF);
    state.set(4, (state.get(4) + e) & 0xFFFFFFFF);
    state.set(5, (state.get(5) + f) & 0xFFFFFFFF);
    state.set(6, (state.get(6) + g) & 0xFFFFFFFF);
    state.set(7, (state.get(7) + h) & 0xFFFFFFFF);
}

/**
 * Computes the raw SHA-256 hash of a byte array.
 *
 * Pads the input, processes each 64-byte block, and returns the
 * 32-byte (256-bit) digest as a byte array.
 *
 * @param data Input byte array
 * @return 32-byte raw SHA-256 hash
 */
export fn sha256Raw(data: Array<int>): Array<int> {
    let bitLen = data.length() * 8;
    let padded = sha256_pad(data, bitLen);
    let state = copyArray(SHA256_H0);

    let offset = 0;
    let tlen = padded.length();
    while (offset < tlen) {
        let block: Array<int> = [];
        let k = 0;
        while (k < 64) {
            block.push(padded.get(offset + k));
            k = k + 1;
        }
        sha256_compress(state, block);
        offset = offset + 64;
    }

    // Pack 32-bit state words → 32 bytes (big-endian)
    let result: Array<int> = [];
    let i = 0;
    while (i < 8) {
        let val = state.get(i);
        result.push((val >> 24) & 0xFF);
        result.push((val >> 16) & 0xFF);
        result.push((val >> 8) & 0xFF);
        result.push(val & 0xFF);
        i = i + 1;
    }
    return result;
}

/**
 * Computes the SHA-256 hash of a string and returns the hex digest.
 *
 * @param data Input string
 * @return 64-character lowercase hex string
 */
export fn sha256(data: string): string {
    let bytes = stringToBytes(data);
    let hash = sha256Raw(bytes);
    return bytesToHex(hash);
}

/**
 * Computes the SHA-256 hash of a string and returns the raw 32-byte array.
 *
 * @param data Input string
 * @return 32-element byte array
 */
export fn sha256Bytes(data: string): Array<int> {
    let bytes = stringToBytes(data);
    return sha256Raw(bytes);
}

// ============================================================
// SHA-512 (RFC 6234)
// ============================================================

/**
 * SHA-512 K constants — high 32 bits of each 64-bit constant.
 * Combined with SHA512_K_LO at use time via (hi << 32) | lo.
 */
const SHA512_K_HI: Array<int> = [
    0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5,
    0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
