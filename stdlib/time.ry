/**
 * Ruyi Standard Library - Time Module
 *
 * Provides time-related functions for working with timestamps and dates.
 *
 * This module exports two timestamp granularities:
 *   - now()          → Unix SECONDS  (backwards-compatible default)
 *   - nowMs()        → Unix MILLISECONDS (preferred for cross-module use)
 *   - timestamp()    → Unix MILLISECONDS (alias, same as nowMs)
 *
 * New code that interacts with other modules (e.g. datetime) should
 * prefer nowMs() to avoid silent unit-mismatch bugs.
 *
 * @author Ruyi Team
 * @date 2026-07-12
 */

// ============================================================
// Time Functions
// ============================================================

/**
 * Returns the current Unix timestamp in SECONDS.
 *
 * For backwards compatibility this function continues to return seconds.
 * New cross-module code should prefer nowMs() which returns milliseconds.
 *
 * @return Current Unix timestamp in seconds
 */
export fn now(): int {
    return __time_now();
}

/**
 * Returns the current Unix timestamp in MILLISECONDS.
 *
 * This is the recommended function for cross-module use (e.g. with the
 * datetime module) which expects millisecond-precision timestamps.
 *
 * @return Current Unix timestamp in milliseconds
 */
export fn nowMs(): int {
    return __time_timestamp();
}

/**
 * Returns the current Unix timestamp in milliseconds.
 *
 * @return Current Unix timestamp in milliseconds
 */
export fn timestamp(): int {
    return __time_timestamp();
}

/**
 * Sleeps for the specified number of seconds.
 *
 * @param seconds Number of seconds to sleep
 */
export fn sleep(seconds: float): void {
    __time_sleep(seconds);
}

/**
 * Formats a Unix timestamp into a string.
 *
 * Returns a simple ISO 8601 format string: "YYYY-MM-DD HH:MM:SS"
 *
 * IMPORTANT: This function interprets the timestamp in SECONDS
 * (for backwards compatibility). If you have a millisecond timestamp,
 * divide by 1000 before passing it here.
 *
 * @param timestamp Unix timestamp in seconds
 * @return Formatted date-time string
 */
export fn format_time(timestamp: int): string {
    return __time_format(timestamp);
}

/**
 * Returns the current time as a formatted string.
 *
 * @return Current time as "YYYY-MM-DD HH:MM:SS"
 */
export fn now_string(): string {
    return format_time(now());
}