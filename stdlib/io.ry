/**
 * Standard Library - IO Module
 *
 * Provides console input/output operations.
 *
 * Note: `print` and `println` are compiler builtins — no import needed.
 * File system operations (read, write, directory manipulation, path
 * utilities, etc.) live in the `fs` module (`stdlib/fs.ry`).
 *
 * @author Ruyi Team
 * @date 2026-05-02
 */

// ============================================================
// Console Input
// ============================================================

/**
 * Reads a single line from stdin.
 * Blocks until a complete line is available.
 * @return The line read, or null on end of input
 */
export fn readLine(): string? {
    return __io_read_line();
}

/**
 * Reads a single character from stdin.
 * Blocks until input is available.
 * @return The character read, or null on end of input
 */
export fn readChar(): string? {
    let line = __io_read_line();
    if (line === null || line.length() === 0) {
        return null;
    }
    return line.charAt(0);
}

/**
 * Reads a line and parses it as an integer.
 * @return The parsed integer, or null on invalid input / EOF
 */
export fn readInt(): int? {
    let line = __io_read_line();
    if (line === null) {
        return null;
    }
    let s = line.trim();
    if (s.length() === 0) {
        return null;
    }
    // Parse sign
    let sign = 1;
    let start = 0;
    if (s.charAt(0) === "-") {
        sign = -1;
        start = 1;
    } else if (s.charAt(0) === "+") {
        start = 1;
    }
    // Parse digits
    let value = 0;
    let i = start;
    while (i < s.length()) {
        let c = s.charCodeAt(i);
        if (c >= 48 && c <= 57) {
            value = value * 10 + (c - 48);
            i = i + 1;
        } else {
            return null;
        }
    }
    if (i === start) {
        return null;
    }
    return sign * value;
}

/**
 * Reads a line and parses it as a float.
 * Supports optional sign, integer part, decimal point, and fractional part.
 * @return The parsed float, or null on invalid input / EOF
 */
export fn readFloat(): float? {
    let line = __io_read_line();
    if (line === null) {
        return null;
    }
    let s = line.trim();
    if (s.length() === 0) {
        return null;
    }
    // Manual parse: sign (int-part) [. (frac-part)]
    let sign = 1.0;
    let start = 0;
    if (s.charAt(0) === "-") {
        sign = -1.0;
        start = 1;
    } else if (s.charAt(0) === "+") {
        start = 1;
    }
    // Integer part
    let intPart = 0.0;
    let i = start;
    while (i < s.length()) {
        let c = s.charCodeAt(i);
        if (c >= 48 && c <= 57) {
            intPart = intPart * 10.0 + (c - 48);
            i = i + 1;
        } else {
            break;
        }
    }
    // Fractional part
    let frac = 0.0;
    if (i < s.length() && s.charAt(i) === ".") {
        i = i + 1;
        let divisor = 10.0;
        while (i < s.length()) {
            let c = s.charCodeAt(i);
            if (c >= 48 && c <= 57) {
                frac = frac + (c - 48) / divisor;
                divisor = divisor * 10.0;
                i = i + 1;
            } else {
                return null;
            }
        }
    }
    if (i === start) {
        return null;
    }
    return sign * (intPart + frac);
}

// ============================================================
// Stdio streaming — IoRead / IoWrite
// ============================================================

extern fn __io_read_raw(buf: Array<int>): int;
extern fn __io_write_raw(buf: Array<int>): int;
extern fn __io_write_stderr_raw(buf: Array<int>): int;
extern fn __io_flush(): int;

import { Buffer } from "./buffer";

export class IoReader {
    fn read(size: int): Buffer? {
        let buf = Buffer.alloc(size);
        let n = __io_read_raw(buf.data);
        if (n < 0) { return null; }
        if (n === 0) { return null; }
        return buf;
    }

    fn readLine(): string? {
        return __io_read_line();
    }

    fn readAll(): Buffer {
        let chunks: Array<Buffer> = [];
        loop {
            let chunk = self.read(4096);
            if (chunk === null) { break; }
            chunks.push(chunk);
        }
        return Buffer.concat(chunks);
    }
}

export class IoWriter {
    _ffi: fn(Array<int>): int;

    fn new(writeFfi: fn(Array<int>): int) {
        self._ffi = writeFfi;
        return self;
    }

    fn write(data: Buffer): int {
        return self._ffi(data.data);
    }

    fn writeStr(s: string): int {
        return self.write(Buffer.from(s));
    }

    fn writeLine(s: string): int {
        return self.write(Buffer.from(s + "\n"));
    }

    fn flush(): void {
        __io_flush();
    }
}

export let stdin: IoReader = new IoReader();
export let stdout: IoWriter = new IoWriter(__io_write_raw);
export let stderr: IoWriter = new IoWriter(__io_write_stderr_raw);
