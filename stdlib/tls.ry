/**
 * Ruyi Standard Library — TLS Client & Server
 *
 * Secure sockets via rustls. Client auto-verifies with Mozilla root CAs.
 * Server requires PEM certificate + private key.
 *
 * Usage (client):
 *   import { TlsSocket } from "./tls";
 *   let sock = TlsSocket.connect("example.com", 443);
 *   sock.write("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n");
 *   let r = sock.read(4096);
 *   sock.close();
 *
 * Usage (server):
 *   import { TlsServer } from "./tls";
 *   let cfg = TlsServer.loadConfig(certPem, keyPem);
 *   let server = TlsServer.listen("0.0.0.0", 443, cfg);
 *   let conn = server.accept();
 *   conn.write("HTTP/1.1 200 OK\r\n\r\nHello TLS!");
 *   conn.close();
 *   server.close();
 *
 * @author Ruyi Team
 * @date 2026-07-24
 */

import { TCPSocket, TCPServer } from "./net";
import { Buffer } from "./buffer";

// ============================================================
// TlsSocket — Client
// ============================================================

export class TlsSocket {
    _tls: dyn;
    _sock: TCPSocket;

    static fn connect(host: string, port: int): TlsSocket? {
        let sock = TCPSocket.connect(host, port);
        if (!sock.isValid()) { return null; }
        let handle = __tls_connect(sock._fd, host);
        if (handle === null) { sock.close(); return null; }
        let t = new TlsSocket();
        t._tls = handle;
        t._sock = sock;
        return t;
    }

    fn read(maxLen: int): string {
        return __tls_read_cstr(self._tls, maxLen);
    }

    fn write(data: string): void {
        __tls_write(self._tls, data);
    }

    /**
     * Write raw binary data to the TLS connection.
     *
     * @param data Buffer containing the raw bytes to send
     * @return The number of bytes actually written
     */
    fn writeRaw(data: Buffer): int {
        return __tls_write_raw(self._tls, data.data);
    }

    /**
     * Read raw binary data from the TLS connection into a Buffer.
     *
     * @param size Maximum number of bytes to read
     * @return Buffer containing up to `size` bytes, or empty on EOF/error
     */
    fn readRaw(size: int): Buffer {
        let buf = Buffer.alloc(size);
        let n = __tls_read_raw(self._tls, buf.data);
        if (n <= 0) { return Buffer.alloc(0); }
        return buf;
    }

    fn isValid(): bool {
        return self._tls !== null;
    }

    fn close(): void {
        if (self._tls !== null) {
            __tls_close(self._tls);
            __tls_free(self._tls);
            self._tls = null;
        }
        self._sock.close();
    }
}

// ============================================================
// TlsServerConfig
// ============================================================

export class TlsServerConfig {
    _ptr: dyn;
}

// ============================================================
// TlsServer
// ============================================================

export class TlsServer {
    _server: TCPServer;
    _config: TlsServerConfig;

    /**
     * Parse PEM certificate + key into a reusable server config.
     *
     * @param certPem PEM-encoded certificate chain
     * @param keyPem PEM-encoded private key
     * @return Config handle, or null on parse error
     */
    static fn loadConfig(certPem: string, keyPem: string): TlsServerConfig? {
        let ptr = __tls_server_config_new(certPem, keyPem);
        if (ptr === null) { return null; }
        let c = new TlsServerConfig();
        c._ptr = ptr;
        return c;
    }

    /**
     * Listen on {host}:{port} with the given TLS config.
     * Each accepted connection is automatically upgraded to TLS.
     */
    static fn listen(host: string, port: int, config: TlsServerConfig): TlsServer {
        let s = new TlsServer();
        s._server = TCPServer.listen(host, port);
        s._config = config;
        return s;
    }

    /**
     * Accept one TLS connection. Blocks until a client connects.
     * Returns null on handshake failure (connection dropped).
     */
    fn accept(): TlsSocket? {
        let client = self._server.accept();
        if (!client.isValid()) { return null; }

        let tlsHandle = __tls_server_accept(self._config._ptr, client._fd);
        if (tlsHandle === null) { client.close(); return null; }

        let sock = new TlsSocket();
        sock._tls = tlsHandle;
        sock._sock = client;
        return sock;
    }

    fn close(): void {
        self._server.close();
    }

    fn isValid(): bool {
        return self._server.isValid();
    }
}
