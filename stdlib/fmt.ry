/**
 * Ruyi Standard Library - Format Module
 *
 * Provides a small printf-style `format()` and a convenience `println()`
 * that expand `{}` placeholders in a template string against the supplied
 * positional arguments. The first `{}` consumes the first argument, the
 * second `{}` consumes the second, and so on; placeholders without a
 * matching argument are left untouched.
 *
 * Substitution is delegated in one pass to the runtime FFI
 * `__fmt_format_dyn`, which decodes each boxed dyn element of the
 * rest-pack array (int/float/bool/string) and returns the formatted
 * result. A Ruyi-side loop cannot express this: `replace_all` swaps
 * every remaining placeholder with the same argument each pass.
 *
 * @author Ruyi Team
 * @date 2026-07-11
 */

// ============================================================
// Public surface
// ============================================================

/**
 * Substitute `{}` placeholders in `template` with the string form of
 * each successive `arg`.
 *
 * @param template Template string containing `{}` placeholders
 * @param args Positional values to substitute into the placeholders
 * @return Resulting string after substitution
 */
export fn format(template: string, ...args: dyn): string {
    return __fmt_format_dyn(template, args);
}

/**
 * Format the template and print the result followed by a newline.
 *
 * @param template Template string containing `{}` placeholders
 * @param args Positional values to substitute
 */
export fn println(template: string, ...args: dyn): void {
    print(__fmt_format_dyn(template, args) + "\n");
}
