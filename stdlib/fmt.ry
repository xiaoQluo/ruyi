/**
 * Ruyi Standard Library - Format Module
 *
 * Provides a small printf-style `format()` and a convenience `println()`
 * that expand `{}` placeholders in a template string against the supplied
 * positional arguments. Each `{}` consumes the next argument's
 * `.toString()` form (resolved by the codegen layer: `int.toString()`
 * → `ruyi_int_to_string`, `float.toString()` → `ruyi_float_to_string`,
 * `bool.toString()` → `ruyi_bool_to_string`).
 *
 * The stdlib layer is intentionally thin: every actual substitution is
 * delegated to the runtime FFI `__string_replace_all`. No regex, no
 * allocation of intermediate buffers by the stdlib.
 *
 * @author Ruyi Team
 * @date 2026-07-11
 */

// ============================================================
// Public surface
// ============================================================

/**
 * Substitute `{}` placeholders in `template` with the string form of
 * each successive `arg`. The first `{}` consumes the first argument,
 * the second `{}` consumes the second, and so on. Placeholders that
 * have no matching argument are left untouched in the output.
 *
 * @param template Template string containing `{}` placeholders
 * @param args Positional values to substitute into the placeholders
 * @return Resulting string after substitution
 */
export fn format(template: string, ...args: dyn): string {
    let result = template;
    let i = 0;
    while (i < args.length) {
        let arg: dyn = args[i];
        result = __string_replace_all_legacy(result, "{}", arg.toString());
        i = i + 1;
    }
    return result;
}

/**
 * Format the template and print the result followed by a newline.
 *
 * @param template Template string containing `{}` placeholders
 * @param args Positional values to substitute
 */
export fn println(template: string, ...args: dyn): void {
    print(format(template, args) + "\n");
}
