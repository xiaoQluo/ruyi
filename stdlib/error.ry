/**
 * Ruyi Standard Library - Error Types
 *
 * Provides a hierarchy of error types for error handling.
 *
 * @author Ruyi Team
 * @date 2026-05-02
 */

export class Error {
    message: string;
    stackTrace: Array<string>;

    fn new(message: string) {
        self.message = message;
        // stackTrace populated by runtime during throw
        self.stackTrace = [];
    }

    fn getMessage(self): string {
        return self.message;
    }

    fn getStackTrace(self): Array<string> {
        return self.stackTrace;
    }

    fn toString(self): string {
        return self.message;
    }
}

export class TypeError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

export class RuntimeError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

/** Base class for logic/programming errors (assertions, invalid arguments). */
export class LogicError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

export class RangeError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

export class AssertionError extends LogicError {
    fn new(message: string) {
        super.new(message);
    }
}

export class ArgumentError extends LogicError {
    fn new(message: string) {
        super.new(message);
    }
}

export class NullError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

export class ArithmeticError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

export class IteratorError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

export class ParseError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

export class NullAssertionError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

export class IOError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

export fn assert(condition: bool, message: string): void {
    if (!condition) {
        throw AssertionError.new(message);
    }
}

export fn assertNotNull<T>(value: T?, message: string): T {
    if (value === null) {
        throw NullAssertionError.new(message);
    }
    return value;
}
