/**
 * Ruyi Standard Library - Error Types
 *
 * Provides a hierarchy of error types for error handling.
 *
 * @author Ruyi Team
 * @date 2026-05-02
 */

class Error {
    message: string;

    fn new(message: string) {
        self.message = message;
    }

    fn getMessage(self): string {
        return self.message;
    }

    fn toString(self): string {
        return self.message;
    }
}

class TypeError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

class RuntimeError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

class RangeError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

class AssertionError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

class ArgumentError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

class NullError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

class ArithmeticError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

class IteratorError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

class ParseError extends Error {
    fn new(message: string) {
        super.new(message);
    }
}

fn assert(condition: bool, message: string): void {
    if (!condition) {
        throw AssertionError.new(message);
    }
}
