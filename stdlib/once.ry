/**
 * Ruyi Standard Library — Once
 *
 * One-time initialisation guard. The first thread to call `do()` succeeds;
 * all subsequent callers return immediately.
 *
 * Unlike `std::sync::Once` in Rust, this version stores no value — it is
 * purely a "has this been called?" flag.
 *
 * Usage:
 *   import { Once } from "./once";
 *   let INIT = Once.new();
 *   let first = INIT.do();            // true only for the first caller
 *   let done = INIT.isCompleted();    // true after the first do()
 *   INIT.free();
 *
 * @author Ruyi Team
 * @date 2026-07-25
 */

export class Once {
    _ptr: dyn;

    /** Create a new Once guard (not yet triggered). */
    static fn new(): Once {
        let o = new Once();
        o._ptr = __once_new();
        return o;
    }

    /** Trigger the guard.
     *  Returns true exactly once — for the first caller — and false for
     *  every subsequent caller. Callers use this to guard a block:
     *  `if (INIT.do()) { ...one-time setup... }`.
     */
    fn do(): bool {
        return __once_trigger(self._ptr) !== 0;
    }

    /** Check whether the Once guard has already been triggered. */
    fn isCompleted(): bool {
        return __once_is_completed(self._ptr) !== 0;
    }

    /** Reset the Once guard (NOT thread-safe). */
    fn reset(): void {
        __once_reset(self._ptr);
    }

    /** Deallocate the Once guard. */
    fn free(): void {
        __once_free(self._ptr);
    }
}
