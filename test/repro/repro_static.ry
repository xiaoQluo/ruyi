// =============================================================================
// 回归测试用例:类静态方法的 Receiver 误传问题
// =============================================================================
// 历史背景:曾因编译期未正确区分静态方法与实例方法,导致 Counter.now()
// 被错误地绑定 self 作为 receiver,触发 ABI 不匹配(段错误)。
// 修复后,静态方法调用不再传入 self。
//
// 预期输出(修复后):
//   42
//
// 注意:本文件不参与 examples/run_examples.sh 的运行,由 test/repro/ 维护。
// =============================================================================

class Counter {
    static fn now(): int {
        return 42;
    }
}

fn main() {
    let x = Counter.now();
    print(x);
}
