// =============================================================================
// 回归测试用例:导入 stdlib 常量后调用 charAt
// =============================================================================
// 历史背景:曾因 stdlib/encoding.ry 中导入常量 HEX_CHARS 后调用 charAt
// 触发 codegen 顺序问题(常量未在 codegen 阶段被 emit),导致段错误或输出为空。
// 本文件作为该 bug 的最小复现用例保留,供未来回归验证使用。
//
// 预期输出(修复后):
//   before
//   3
//   after
//
// 注意:本文件不参与 examples/run_examples.sh 的运行,由 test/repro/ 维护。
// =============================================================================

import { HEX_CHARS } from "encoding";

fn main() {
    print("before\n");
    let c = HEX_CHARS.charAt(3);
    print(c);
    print("after\n");
}
