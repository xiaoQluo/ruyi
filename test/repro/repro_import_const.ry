// =============================================================================
// 回归测试用例:导入 stdlib 常量后调用 charAt(let 绑定优先于 print)
// =============================================================================
// 历史背景:与 repro_charat.ry 同源,验证常量导入后变量绑定与函数调用
// 的 codegen 顺序同样正确。区别在于 let c 的位置不同。
//
// 预期输出(修复后):
//   before
//   3
//   after
//
// 注意:本文件不参与 examples/run_examples.sh 的运行,由 test/repro/ 维护。
// =============================================================================

import { HEX_CHARS } from "encoding";

fn main() {
    let c = HEX_CHARS.charAt(3);
    print("before\n");
    print(c);
    print("after\n");
}
