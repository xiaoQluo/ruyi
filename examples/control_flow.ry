// =============================================================================
// Control Flow - Ruyi Tutorial Chapter 3
// =============================================================================
// Covers: if/else, if as expression, for, for-in, for-of, while,
//         break, continue, labeled break/continue
// =============================================================================

// -----------------------------------------------------------------------------
// 3.1 if / else
// -----------------------------------------------------------------------------
fn classifyNumber(n: int): string {
  if (n > 0) {
    return "positive";
  } else if (n < 0) {
    return "negative";
  } else {
    return "zero";
  }
}

// -----------------------------------------------------------------------------
// 3.2 if as an Expression (simulated with early returns)
// -----------------------------------------------------------------------------
fn signLabel(x: int): string {
  if (x > 0) {
    return "positive";
  }
  if (x < 0) {
    return "negative";
  }
  return "zero";
}

// -----------------------------------------------------------------------------
// 3.3 C-style for Loop
// -----------------------------------------------------------------------------
fn printRange(start: int, end: int) {
  for (let i = start; i < end; i = i + 1) {
    print(i);
    print(" ");
  }
  print("\n");
}

// Reverse iteration
fn printReverse(end: int) {
  for (let i = end - 1; i >= 0; i = i - 1) {
    print(i);
    print(" ");
  }
  print("\n");
}

// -----------------------------------------------------------------------------
// 3.6 while Loop
// -----------------------------------------------------------------------------
fn whileCountdown(from: int) {
  let i = from;
  while (i > 0) {
    print(i);
    print(" ");
    i = i - 1;
  }
  print("liftoff!\n");
}

// -----------------------------------------------------------------------------
// 3.7 break and continue
// -----------------------------------------------------------------------------
fn breakDemo() {
  print("break demo (stop at 5):\n");
  for (let i = 0; i < 10; i = i + 1) {
    if (i === 5) {
      break;
    }
    print(i);
    print(" ");
  }
  print("\n");
}

fn continueDemo() {
  print("continue demo (skip evens):\n");
  for (let i = 0; i < 10; i = i + 1) {
    if (i % 2 === 0) {
      continue;
    }
    print(i);
    print(" ");
  }
  print("\n");
}

// -----------------------------------------------------------------------------
// 3.8 Labeled Break and Continue
// -----------------------------------------------------------------------------
fn labeledBreakDemo() {
  print("labeled break demo:\n");
  outer: for (let i = 1; i <= 3; i = i + 1) {
    for (let j = 1; j <= 3; j = j + 1) {
      let product = i * j;
      if (product > 6) {
        break outer;
      }
      print(i);
      print(" * ");
      print(j);
      print(" = ");
      print(product);
      print("\n");
    }
  }
}

fn main() {
  print("=== Control Flow Demo ===\n\n");

  // 3.1 if / else
  print("--- if / else ---\n");
  print("classifyNumber(10): ");
  print(classifyNumber(10));
  print("\nclassifyNumber(-5): ");
  print(classifyNumber(-5));
  print("\nclassifyNumber(0): ");
  print(classifyNumber(0));
  print("\n\n");

  // 3.2 if as expression
  print("--- if as expression ---\n");
  print("signLabel(42): ");
  print(signLabel(42));
  print("\nsignLabel(-7): ");
  print(signLabel(-7));
  print("\nsignLabel(0): ");
  print(signLabel(0));
  print("\n\n");

  // 3.3 for loop
  print("--- for loop (0 to 9) ---\n");
  printRange(0, 10);

  print("--- for loop reverse (5 to 0) ---\n");
  printReverse(5);

  // 3.6 while loop
  print("--- while countdown ---\n");
  whileCountdown(5);

  // 3.7 break and continue
  print("\n");
  breakDemo();
  continueDemo();

  // 3.8 labeled break
  print("\n");
  labeledBreakDemo();

  print("\nAll control flow demos completed successfully!\n");
}
