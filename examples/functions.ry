// =============================================================================
// Functions - Ruyi Tutorial Chapter 4
// =============================================================================
// Covers: fn declarations, return type inference, arrow functions,
//         default params
// =============================================================================

// -----------------------------------------------------------------------------
// 4.1 Function Declarations
// -----------------------------------------------------------------------------
fn add(a: int, b: int): int {
  return a + b;
}

// -----------------------------------------------------------------------------
// 4.2 Return Type Inference
// -----------------------------------------------------------------------------
// Inferred return type: int
fn multiply(a: int, b: int) {
  return a * b;
}

// Inferred return type: void
fn greet(name: string) {
  print("Hello, ");
  print(name);
  print("!\n");
}

// Inferred return type: float (least upper bound of int and float)
fn maybeNumber(flag: bool) {
  if (flag) {
    return 42;
  } else {
    return 3.14;
  }
}

// -----------------------------------------------------------------------------
// 4.3 Arrow Functions
// -----------------------------------------------------------------------------
fn arrowDemo() {
  // Single expression arrow (implicit return)
  let double = (x) => x * 2;
  let square = (x) => x * x;

  print("double(5): ");
  print(double(5));
  print("\n");

  print("square(7): ");
  print(square(7));
  print("\n");

  // Block arrow function
  let greetArrow = (name) => {
    print("Hi, ");
    print(name);
    print("!\n");
  };
  greetArrow("Ruyi");
}

// -----------------------------------------------------------------------------
// 4.4 Default Parameters
// -----------------------------------------------------------------------------
fn greetWithDefault(name: string = "World") {
  print("Hello, ");
  print(name);
  print("!\n");
}

fn paramDemo() {
  print("--- Default Parameters ---\n");
  greetWithDefault();
  greetWithDefault("Ruyi");
  print("\n");
}

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------
fn main() {
  print("=== Functions Demo ===\n\n");

  // Basic function calls
  print("--- Basic Functions ---\n");
  print("add(3, 5): ");
  print(add(3, 5));
  print("\n");

  print("multiply(4, 6): ");
  print(multiply(4, 6));
  print("\n");

  greet("Developer");

  print("\nmaybeNumber(true): ");
  print(maybeNumber(true));
  print("\nmaybeNumber(false): ");
  print(maybeNumber(false));
  print("\n\n");

  // Arrow functions
  print("--- Arrow Functions ---\n");
  arrowDemo();

  // Parameters
  print("\n");
  paramDemo();

  print("\nAll function demos completed successfully!\n");
}
