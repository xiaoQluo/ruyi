// =============================================================================
// Variables and Types - Ruyi Tutorial Chapter 2: Basic Syntax
// =============================================================================
// Covers: let/const, built-in types, type annotations, numeric literals,
//         string literals, operators, comments
// =============================================================================

// -----------------------------------------------------------------------------
// 2.7 Comments
// -----------------------------------------------------------------------------
// Single-line comment

/* Multi-line
   comment */

/**
 * Documentation comment.
 * Preserved for tooling.
 */

// -----------------------------------------------------------------------------
// Main entry point
// -----------------------------------------------------------------------------
fn main() {
  print("=== Variables and Types Demo ===\n\n");

  // 2.1 let/const
  let mutableVar: int = 42;
  mutableVar = 100;
  const PI: float = 3.14159;

  // Block scoping
  {
    let inner: string = "visible inside";
    print(inner);
    print("\n");
  }

  // 2.2 Built-in types
  let count: int = 42;
  let name: string = "Ruyi";
  let ratio: float = 0.75;
  let active: bool = true;

  // Type inference
  let x = 42;
  let y = "hello";
  let z = true;

  // No initializer + no annotation => dyn
  let unknown;

  // 2.4 Numeric literals
  let decimal: int = 42;
  let negative: int = -7;
  let pi: float = 3.14159;
  let scientific: float = 1e10;
  let small: float = 0.001;
  let hex: int = 0xFF;
  let octal: int = 0o77;
  let binary: int = 0b1010;

  print("=== Numeric Literals ===\n");
  print("decimal: ");
  print(decimal);
  print("\nnegative: ");
  print(negative);
  print("\nhex (0xFF): ");
  print(hex);
  print("\noctal (0o77): ");
  print(octal);
  print("\nbinary (0b1010): ");
  print(binary);
  print("\nbig: ");
  print("(planned)");
  print("\n");

  // 2.5 String literals
  let greeting: string = "Hello, Ruyi!";
  let singleQuoted: string = 'World';
  let escaped: string = "line1\nline2\ttab";
  print("=== String Literals ===\n");
  print(greeting);
  print("\n");
  print(singleQuoted);
  print("\n");
  print(escaped);
  print("\n");

  // 2.6 Arithmetic operators
  let sum: int = 10 + 3;
  let diff: int = 10 - 3;
  let product: int = 10 * 3;
  let quotient: int = 10 / 3;
  let remainder: int = 10 % 3;
  let power: int = 2 ** 8;

  print("=== Arithmetic Operators ===\n");
  print("10 + 3 = ");
  print(sum);
  print("\n10 - 3 = ");
  print(diff);
  print("\n10 * 3 = ");
  print(product);
  print("\n10 / 3 = ");
  print(quotient);
  print("\n10 % 3 = ");
  print(remainder);
  print("\n2 ** 8 = ");
  print(power);
  print("\n");

  // Comparison operators
  let eq: bool = 5 === 5;
  let neq: bool = 5 !== 3;
  let lt: bool = 3 < 5;
  let gt: bool = 5 > 3;
  let lte: bool = 3 <= 3;
  let gte: bool = 5 >= 5;

  print("=== Comparison Operators ===\n");
  print("5 === 5: ");
  print(eq);
  print("\n5 !== 3: ");
  print(neq);
  print("\n3 < 5: ");
  print(lt);
  print("\n5 > 3: ");
  print(gt);
  print("\n");

  // Logical operators
  let and: bool = true && false;
  let or: bool = true || false;
  let not: bool = !true;

  print("=== Logical Operators ===\n");
  print("true && false: ");
  print(and);
  print("\ntrue || false: ");
  print(or);
  print("\n!true: ");
  print(not);
  print("\n");

  // Nullish coalescing
  let maybeName: string? = null;
  let displayName: string = maybeName ?? "anonymous";

  print("=== Nullish Coalescing ===\n");
  print("null ?? \"anonymous\": ");
  print(displayName);
  print("\n");

  // Demonstrate let vs const
  let counter: int = 0;
  counter = counter + 1;
  print("counter (let): ");
  print(counter);
  print("\n");

  const MAX: int = 100;
  print("MAX (const): ");
  print(MAX);
  print("\n");

  // Demonstrate type inference
  let inferred = 42;
  print("inferred type (42): ");
  print(inferred);
  print("\n");

  // Demonstrate block scoping
  {
    let blockScoped: int = 999;
    print("block-scoped var: ");
    print(blockScoped);
    print("\n");
  }

  print("\nAll basic syntax demos completed successfully!\n");
}
