// v05_tests.ry — v0.5 test framework demo
// Compile with: ruyic examples/v05_tests.ry --check

fn assert_eq(actual: int, expected: int) {
  if (actual !== expected) {
    throw Error("assertion failed: " + actual + " !== " + expected);
  }
}

fn test_add() {
  assert_eq(1 + 1, 2);
  assert_eq(0 + 0, 0);
  assert_eq(-1 + 1, 0);
}

fn test_sub() {
  assert_eq(5 - 3, 2);
  assert_eq(0 - 0, 0);
}

fn test_mul() {
  assert_eq(2 * 3, 6);
  assert_eq(0 * 100, 0);
}

fn main() {
  test_add();
  test_sub();
  test_mul();
  print("All tests passed!\n");
}
