// =============================================================================
// Pattern Matching - Ruyi Tutorial Chapter 9
// =============================================================================
// Covers: match expressions, literal patterns, or patterns, guard clauses,
//         destructuring objects, destructuring arrays, if-let, while-let,
//         as patterns
// =============================================================================

// -----------------------------------------------------------------------------
// 9.1 & 9.2 Match Expressions and Literal Patterns
// -----------------------------------------------------------------------------
fn httpStatusDescription(status: int): string {
  match (status) {
    200 => { return "OK"; }
    404 => { return "Not Found"; }
    500 => { return "Server Error"; }
    _ => { return "Unknown: " + toString(status); }
  }
}

// -----------------------------------------------------------------------------
// 9.3 Or Patterns
// -----------------------------------------------------------------------------
fn sizeCategory(value: int): string {
  match (value) {
    1 | 2 | 3 => { return "small"; }
    4 | 5 | 6 => { return "medium"; }
    _ => { return "large"; }
  }
}

// -----------------------------------------------------------------------------
// 9.4 Guard Clauses
// -----------------------------------------------------------------------------
fn digitDescription(n: int): string {
  match (n) {
    0 => { return "zero"; }
    n if (n > 0 && n < 10) => { return "single digit: " + toString(n); }
    n if (n >= 10 && n < 100) => { return "double digit: " + toString(n); }
    _ => { return "other"; }
  }
}

// -----------------------------------------------------------------------------
// 9.5 Destructuring Objects
// -----------------------------------------------------------------------------
class HttpResponse {
  status: int;
  body: string;
  fn new(status: int, body: string) {
    self.status = status;
    self.body = body;
  }
}

fn handleResponse(response: HttpResponse) {
  match (response) {
    { status: 200, body } => { print("Body: "); print(body); print("\n"); }
    { status: 404, body } => { print("Not found\n"); }
    { status, body } => { print("Error "); print(status); print(": "); print(body); print("\n"); }
    _ => { print("unknown response\n"); }
  }
}

// -----------------------------------------------------------------------------
// 9.6 Destructuring Arrays
// -----------------------------------------------------------------------------
fn describeList(list: Array<int>) {
  match (list) {
    [] => { print("empty\n"); }
    [first] => { print("single: "); print(first); print("\n"); }
    [first, second, ...rest] => {
      print("first: ");
      print(first);
      print(", second: ");
      print(second);
      print("\n");
    }
    _ => { print("other\n"); }
  }
}

// -----------------------------------------------------------------------------
// 9.7 if-let Statement
// -----------------------------------------------------------------------------
fn ifLetDemo() {
  print("--- if-let ---\n");

  let point = { x: 3.0, y: 4.0 };
  if let { x, y } = point {
    print("point at (");
    print(x);
    print(", ");
    print(y);
    print(")\n");
  }

  // if-let with else
  let result: int? = 42;
  if let value = result {
    print("success: ");
    print(value);
    print("\n");
  } else {
    print("failed\n");
  }

  // if-let with null
  let nothing: int? = null;
  if let value = nothing {
    print("should not print\n");
  } else {
    print("got null\n");
  }
}

// -----------------------------------------------------------------------------
// 9.8 while-let Statement
// -----------------------------------------------------------------------------
class NumberIterator {
  current: int;
  max: int;

  fn new(max: int) {
    self.current = 0;
    self.max = max;
  }

  fn next(): int? {
    if (self.current >= self.max) {
      return null;
    }
    let value: int = self.current;
    self.current = self.current + 1;
    return value;
  }
}

fn whileLetDemo() {
  print("--- while-let ---\n");

  let iter = NumberIterator.new(5);
  while let item = iter.next() {
    print(item);
    print(" ");
  }
  print("\n");
}

// -----------------------------------------------------------------------------
// 9.9 as Patterns
// -----------------------------------------------------------------------------
fn asPatternDemo() {
  print("--- as Patterns ---\n");

  let value = { x: 1.0, y: 2.0 };
  match (value) {
    { x, y } => {
      print("point: ");
      print(value);
      print("\nx: ");
      print(x);
      print(", y: ");
      print(y);
      print("\n");
    }
    _ => { print("not a point\n"); }
  }
}

// -----------------------------------------------------------------------------
// Match as Expression
// -----------------------------------------------------------------------------
fn absoluteValue(n: int): int {
  return match (n) {
    n if (n < 0) => { -n }
    _ => { n }
  };
}

fn matchExpressionDemo() {
  print("--- Match as Expression ---\n");

  print("absoluteValue(-5): ");
  print(absoluteValue(-5));
  print("\nabsoluteValue(3): ");
  print(absoluteValue(3));
  print("\n");
}

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------
fn main() {
  print("=== Pattern Matching Demo ===\n\n");

  // Literal patterns
  print("--- Literal Patterns ---\n");
  print("200: ");
  print(httpStatusDescription(200));
  print("\n404: ");
  print(httpStatusDescription(404));
  print("\n503: ");
  print(httpStatusDescription(503));
  print("\n\n");

  // Or patterns
  print("--- Or Patterns ---\n");
  print("2: ");
  print(sizeCategory(2));
  print("\n5: ");
  print(sizeCategory(5));
  print("\n10: ");
  print(sizeCategory(10));
  print("\n\n");

  // Guard clauses
  print("--- Guard Clauses ---\n");
  print("0: ");
  print(digitDescription(0));
  print("\n7: ");
  print(digitDescription(7));
  print("\n42: ");
  print(digitDescription(42));
  print("\n\n");

  // Object destructuring
  print("--- Object Destructuring ---\n");
  handleResponse(HttpResponse.new(200, "Hello"));
  handleResponse(HttpResponse.new(404, "Missing"));
  handleResponse(HttpResponse.new(500, "Crash"));
  print("\n");

  // Array destructuring
  print("--- Array Destructuring ---\n");
  describeList([]);
  describeList([42]);
  describeList([1, 2, 3, 4, 5]);
  print("\n");

  // if-let
  ifLetDemo();
  print("\n");

  // while-let
  whileLetDemo();
  print("\n");

  // as patterns
  asPatternDemo();
  print("\n");

  // match as expression
  matchExpressionDemo();

  print("\nAll pattern matching demos completed successfully!\n");
}
