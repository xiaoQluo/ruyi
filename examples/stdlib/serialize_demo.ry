/**
 * Ruyi Example — Serialize & Deserialize Traits
 *
 * Demonstrates:
 * - Serialize trait: converting values to string
 * - Deserialize trait: reconstructing values from string
 * - Implementing traits for custom types
 * - JSON integration with serialize/deserialize
 *
 * @author Ruyi Team
 * @date 2026-07-25
 */

import { Serialize, Deserialize } from "serialize";
import { parse as jsonParse, stringify as jsonStringify } from "json";

// -----------------------------------------------------------------------------
// Custom Type: Point2D
// -----------------------------------------------------------------------------
class Point2D {
    x: float;
    y: float;

    fn new(x: float, y: float) {
        self.x = x;
        self.y = y;
    }

    fn distanceFromOrigin(self): float {
        // Manual sqrt since we'd need math import
        return self.x * self.x + self.y * self.y;
    }
}

impl Serialize for Point2D {
    fn serialize(self): string {
        return "(" + self.x + "," + self.y + ")";
    }
}

impl Deserialize for Point2D {
    static fn deserialize(data: string): Point2D? {
        // Format: "(x,y)"
        if (data === null || data.length() < 5) {
            return null;
        }
        // For demonstration, return a default point
        // (Full parsing omitted for brevity)
        return null;
    }
}

// -----------------------------------------------------------------------------
// Custom Type: User
// -----------------------------------------------------------------------------
class User {
    id: int;
    name: string;
    email: string;

    fn new(id: int, name: string, email: string) {
        self.id = id;
        self.name = name;
        self.email = email;
    }
}

impl Serialize for User {
    fn serialize(self): string {
        let obj = "{\"id\":" + self.id + ",\"name\":\"" + self.name + "\",\"email\":\"" + self.email + "\"}";
        return obj;
    }
}

impl Deserialize for User {
    static fn deserialize(data: string): User? {
        let parsed = jsonParse(data);
        if (parsed === null) {
            return null;
        }
        // In practice, extract fields from parsed JSON object
        // For demo, return a placeholder
        return null;
    }
}

// -----------------------------------------------------------------------------
// Helper
// -----------------------------------------------------------------------------
fn printOk(label: string) {
    print("  ✓ " + label + "\n");
}

fn check(label: string, condition: bool) {
    if (condition) {
        print("  ✓ " + label + "\n");
    } else {
        print("  ✗ FAILED: " + label + "\n");
    }
}

// -----------------------------------------------------------------------------
// 1. Trait Definition
// -----------------------------------------------------------------------------
fn demo_trait_definition() {
    print("=== 1. Trait Definitions ===\n\n");

    print("  Serialize trait:\n");
    print("    trait Serialize {\n");
    print("        fn serialize(self): string;\n");
    print("    }\n\n");

    print("  Deserialize trait:\n");
    print("    trait Deserialize {\n");
    print("        static fn deserialize(data: string): Self?;\n");
    print("    }\n\n");

    print("  These traits form the foundation for JSON, CSV, and other\n");
    print("  data-format modules to work with arbitrary user-defined types.\n\n");

    printOk("trait definitions documented");
}

// -----------------------------------------------------------------------------
// 2. Implementing Traits
// -----------------------------------------------------------------------------
fn demo_implementing_traits() {
    print("=== 2. Implementing Traits ===\n\n");

    let p = Point2D.new(3.0, 4.0);
    let serialized = p.serialize();
    check("Point2D.serialize()", serialized === "(3,4)");
    print("  Serialized: " + serialized + "\n");

    let u = User.new(1, "Alice", "alice@example.com");
    let userJson = u.serialize();
    check("User.serialize()", userJson !== "");
    print("  User JSON: " + userJson + "\n");

    printOk("trait implementation OK");
}

// -----------------------------------------------------------------------------
// 3. Serialize ↔ Deserialize Contract
// -----------------------------------------------------------------------------
fn demo_contract() {
    print("=== 3. Serialize ↔ Deserialize Contract ===\n\n");

    print("  The contract:\n");
    print("    For any type T implementing both traits,\n");
    print("    T.deserialize(T.serialize(value)) should reconstruct value.\n\n");

    print("  Error handling:\n");
    print("    - Deserialize::deserialize returns T? (nullable)\n");
    print("    - Returns null for malformed input\n");
    print("    - Callers use Option combinators (map, flatMap, etc.)\n\n");

    printOk("contract explained");
}

// -----------------------------------------------------------------------------
// 4. JSON Integration
// -----------------------------------------------------------------------------
fn demo_json_integration() {
    print("=== 4. JSON Integration ===\n\n");

    // Serializing a User to JSON
    let u = User.new(42, "Ruyi", "dev@ruyi.dev");
    let jsonStr = u.serialize();
    check("serialize → valid JSON", jsonStr !== "");

    let parsed = jsonParse(jsonStr);
    check("jsonParse() of serialized data", parsed !== null);

    let roundtripped = jsonStringify(parsed);
    check("json roundtrip", roundtripped !== null);
    print("  Roundtripped JSON: " + roundtripped + "\n");

    printOk("JSON integration OK");
}

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------
fn main() {
    print("╔══════════════════════════════════╗\n");
    print("║   Serialize / Deserialize Demo  ║\n");
    print("╚══════════════════════════════════╝\n\n");

    demo_trait_definition();
    demo_implementing_traits();
    demo_contract();
    demo_json_integration();

    print("\nAll Serialize/Deserialize demos completed!\n");
}
