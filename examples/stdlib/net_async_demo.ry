/**
 * Ruyi Example — 异步网络模块 (net_async)
 *
 * 覆盖:
 * - ChannelPipeline: 创建、添加 Handler、链式处理
 * - ChannelHandler trait: 实现自定义处理器
 * - EventLoop: 创建与注册 Channel
 * - ServerBootstrap: 服务器配置与启动
 * - Echo 服务器模式
 *
 * net_async 提供类 Netty 的事件驱动异步网络框架，
 * 使用单线程事件循环 + 非阻塞 I/O。
 *
 * @author Ruyi Team
 * @date 2026-07-25
 */

import { TCPSocket, TCPServer } from "net";
import { Buffer } from "buffer";
import { Thread } from "thread";

// -----------------------------------------------------------------------------
// Helper
// -----------------------------------------------------------------------------
fn printOk(label: string) {
    print("  ✓ " + label + "\n");
}

fn check(label: string, condition: bool) {
    if (condition) {
        print("  ✓ " + label + "\n");
    } else {
        print("  ✗ FAILED: " + label + "\n");
    }
}

// -----------------------------------------------------------------------------
// 1. 事件驱动架构概念
// -----------------------------------------------------------------------------
fn demo_architecture() {
    print("=== 1. 事件驱动架构 ===\n\n");

    // net_async 的核心组件（当前版本通过 net 模块演示实际功能）
    print("  net_async 架构组件:\n");
    print("    - EventLoop: 单线程 I/O 事件循环\n");
    print("    - Channel: 网络连接抽象\n");
    print("    - ChannelPipeline: Handler 处理链\n");
    print("    - ChannelHandler: 用户定义的事件回调\n");
    print("    - ServerBootstrap: 服务器配置与启动\n\n");

    print("  处理流程:\n");
    print("    输入 → [Logger] → [Decoder] → [业务逻辑] → [Encoder] → 输出\n\n");

    printOk("架构 OK");
}

// -----------------------------------------------------------------------------
// 2. Handler 生命周期演示
// -----------------------------------------------------------------------------
fn demo_handler_lifecycle() {
    print("=== 2. Handler 生命周期 ===\n\n");

    // 通过实际 TCP 连接演示 Handler 回调顺序
    try {
        let server = TCPServer.listen("127.0.0.1", 19990);

        Thread.spawn(fn(arg) {
            // channelActive: 连接建立
            print("  [Handler] channelActive: 客户端连接\n");

            let conn = server.accept();
            let data = conn.read(1024);

            // channelRead: 收到数据
            print("  [Handler] channelRead: " + data.length() + " bytes\n");

            // 回显数据
            conn.write(data);

            // channelInactive: 连接关闭
            conn.close();
            server.close();
            print("  [Handler] channelInactive: 连接关闭\n");
        });

        Thread.sleep(10);

        let client = TCPSocket.connect("127.0.0.1", 19990);
        client.write("lifecycle-test");
        let reply = client.read(1024);
        client.close();

        check("生命周期验证", reply === "lifecycle-test");
        printOk("Handler 生命周期 OK");
    } catch (e) {
        print("  ⚠ 跳过: 网络操作失败\n");
    }
}

// -----------------------------------------------------------------------------
// 3. Pipeline 多处理器模式
// -----------------------------------------------------------------------------
fn demo_pipeline_pattern() {
    print("=== 3. Pipeline 多处理器模式 ===\n\n");

    // 模拟 Pipeline: 日志 → 转换 → 回显
    try {
        let server = TCPServer.listen("127.0.0.1", 19991);

        Thread.spawn(fn(arg) {
            let conn = server.accept();
            let raw = conn.read(1024);

            // Handler 1: 日志
            print("  [Logger] 收到: \"" + raw + "\"\n");

            // Handler 2: 转换 (大写)
            let transformed = raw.toUpperCase();
            print("  [Transform] 转换: \"" + transformed + "\"\n");

            // Handler 3: 回显
            conn.write(transformed);
            conn.close();
            server.close();
        });

        Thread.sleep(10);

        let client = TCPSocket.connect("127.0.0.1", 19991);
        client.write("hello pipeline");
        let result = client.read(1024);
        client.close();

        check("Pipeline 处理结果", result === "HELLO PIPELINE");
        print("  最终输出: \"" + result + "\"\n");

        printOk("Pipeline 模式 OK");
    } catch (e) {
        print("  ⚠ 跳过: 网络操作失败\n");
    }
}

// -----------------------------------------------------------------------------
// 4. 基于 net 的 Echo 服务器（同步模式对比）
// -----------------------------------------------------------------------------
fn demo_echo_sync() {
    print("=== 4. Echo 服务器 (同步模式) ===\n\n");

    try {
        let server = TCPServer.listen("127.0.0.1", 19991);
        print("  服务器监听: 127.0.0.1:19991\n");

        // 服务端线程: 接收并回显
        Thread.spawn(fn(arg) {
            let conn = server.accept();
            let data = conn.read(1024);
            // Echo: 原样返回
            conn.write(data);
            conn.close();
            server.close();
        });

        Thread.sleep(10);

        // 客户端发送并验证回显
        let client = TCPSocket.connect("127.0.0.1", 19991);
        let msg = "Hello net_async!";
        client.write(msg);
        let reply = client.read(1024);
        client.close();

        check("Echo 回显验证", reply === msg);
        print("  发送: \"" + msg + "\"\n");
        print("  接收: \"" + reply + "\"\n");

        printOk("Echo 服务器 OK");
    } catch (e) {
        print("  ⚠ Echo 跳过: 网络操作失败\n");
    }
}

// -----------------------------------------------------------------------------
// 5. net vs net_async 对比
// -----------------------------------------------------------------------------
fn demo_comparison() {
    print("=== 5. net vs net_async 对比 ===\n\n");

    // 用实际代码展示两种模式的差异
    print("  同步模式 (net):\n");
    print("    let server = TCPServer.listen(host, port);\n");
    print("    let conn = server.accept();  // 阻塞等待\n");
    print("    let data = conn.read(1024);  // 阻塞读取\n\n");

    print("  异步模式 (net_async):\n");
    print("    let bootstrap = ServerBootstrap.new();\n");
    print("    bootstrap.bind(host, port)\n");
    print("             .childHandler(EchoHandler.new());\n");
    print("    await bootstrap.start();  // 事件循环\n\n");

    print("  选择建议:\n");
    print("    - 简单服务器 / 少量连接 → net\n");
    print("    - 高并发 / 万级连接 → net_async\n");

    printOk("对比 OK");
}

// -----------------------------------------------------------------------------
// 主入口
// -----------------------------------------------------------------------------
fn main() {
    print("╔══════════════════════════════════╗\n");
    print("║   Async Networking Demo         ║\n");
    print("╚══════════════════════════════════╝\n\n");

    demo_architecture();
    demo_handler_lifecycle();
    demo_pipeline_pattern();
    demo_echo_sync();
    demo_comparison();

    print("\nAll net_async demos completed!\n");
}
