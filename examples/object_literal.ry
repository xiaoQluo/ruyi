// object_literal.ry — {k:v} literal and bracket access
// Demonstrates v0.2 P0 (task 1.2): object literal codegen.

let point: { x: int, y: int } = { x: 10, y: 20 };
print("point.x=");
print(point.x);
print("\n");
print("point[\"y\"]=");
print(point["y"]);
print("\n");

// Mutate a field
let counter: { n: int } = { n: 1 };
counter.n = counter.n + 4;
print("counter.n=");
print(counter.n);
print("\n");