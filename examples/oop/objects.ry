// =============================================================================
// Object Literals — Ruyi 对象字面量
// =============================================================================
// 覆盖: {k:v} 字面量创建、点访问、括号访问、字段修改、嵌套对象
// =============================================================================

// -----------------------------------------------------------------------------
// 1. 基础对象字面量与访问
// -----------------------------------------------------------------------------
fn basicDemo() {
  print("--- 基础对象字面量 ---\n");

  // 创建带类型注解的对象
  let point: { x: int, y: int } = { x: 10, y: 20 };
  print(`point.x = ${point.x}\n`);
  print(`point.y = ${point.y}\n`);

  // 括号访问（动态键）
  print(`point["x"] = ${point["x"]}\n`);
  print(`point["y"] = ${point["y"]}\n`);
}

// -----------------------------------------------------------------------------
// 2. 字段修改
// -----------------------------------------------------------------------------
fn mutationDemo() {
  print("--- 字段修改 ---\n");

  let counter: { n: int } = { n: 1 };
  print(`初始值: counter.n = ${counter.n}\n`);

  counter.n = counter.n + 4;
  print(`加 4 后: counter.n = ${counter.n}\n`);

  counter.n = counter.n * 2;
  print(`乘 2 后: counter.n = ${counter.n}\n`);
}

// -----------------------------------------------------------------------------
// 3. 多字段对象
// -----------------------------------------------------------------------------
fn multiFieldDemo() {
  print("--- 多字段对象 ---\n");

  let user = {
    name: "张三",
    age: 28,
    active: true
  };

  print(`姓名: ${user.name}\n`);
  print(`年龄: ${user.age}\n`);
  print(`活跃: ${user.active}\n`);
}

// -----------------------------------------------------------------------------
// 4. 对象作为函数参数与返回值
// -----------------------------------------------------------------------------
fn createPoint(x: int, y: int): { x: int, y: int } {
  return { x: x, y: y };
}

fn distanceSquared(p: { x: int, y: int }): int {
  return p.x * p.x + p.y * p.y;
}

fn functionDemo() {
  print("--- 对象与函数 ---\n");

  let p = createPoint(3, 4);
  print(`创建点: (${p.x}, ${p.y})\n`);
  print(`到原点距离的平方: ${distanceSquared(p)}\n`);
}

// -----------------------------------------------------------------------------
// 主入口
// -----------------------------------------------------------------------------
fn main() {
  print("=== 对象字面量示例 ===\n\n");

  basicDemo();
  print("\n");
  mutationDemo();
  print("\n");
  multiFieldDemo();
  print("\n");
  functionDemo();

  print("\n对象字面量示例完成!\n");
}