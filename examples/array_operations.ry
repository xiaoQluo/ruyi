// array_operations.ry — Array literal, index, push, pop, length
// Demonstrates v0.2 P0 (task 1.3): array literal codegen.

fn main() {
  let arr = [1, 2, 3];
  print("length=");
  print(arr.length());
  print("\n");

  print("arr[0]=");
  print(arr[0]);
  print("\n");

  arr.push(4);
  arr.push(5);
  print("after push length=");
  print(arr.length());
  print("\n");

  let popped = arr.pop();
  print("popped=");
  print(popped);
  print("\n");

  print("arr[3]=");
  print(arr[3]);
  print("\n");
}