// =============================================================================
// Trait Objects (dyn Trait) — Ruyi Dynamic Dispatch
// =============================================================================
// Covers: dyn Trait type, trait object variables, function parameters with
//         dyn Trait, static vs dynamic dispatch
// =============================================================================

// -----------------------------------------------------------------------------
// 1. Define a Trait
// -----------------------------------------------------------------------------
trait Describable {
  fn describe(self): string;
}

// -----------------------------------------------------------------------------
// 2. Implement for Various Types
// -----------------------------------------------------------------------------
impl Describable for string {
  fn describe(self): string {
    return "string: \"" + self + "\"";
  }
}

class Person {
  name: string;
  age: int;

  fn new(name: string, age: int) {
    self.name = name;
    self.age = age;
  }
}

impl Describable for Person {
  fn describe(self): string {
    return "Person { name: \"" + self.name + "\", age: " + self.age.toString() + " }";
  }
}

class Book {
  title: string;
  author: string;

  fn new(title: string, author: string) {
    self.title = title;
    self.author = author;
  }
}

impl Describable for Book {
  fn describe(self): string {
    return "Book { title: \"" + self.title + "\", author: \"" + self.author + "\" }";
  }
}

// -----------------------------------------------------------------------------
// 3. Trait Object Type — Single Object
// -----------------------------------------------------------------------------
fn singleTraitObjectDemo() {
  print("--- Single Trait Object ---\n");

  // Type-erased variable: holds any Describable value
  let desc: dyn Describable = "hello world";

  // Dynamic dispatch through trait object
  print(desc.describe());
  print("\n");

  // Reassign to a different concrete type
  desc = Person.new("Alice", 30);
  print(desc.describe());
  print("\n");
}

// -----------------------------------------------------------------------------
// 4. Polymorphic Variables — multiple trait object assignments
// -----------------------------------------------------------------------------
fn polymorphicVariableDemo() {
  print("--- Polymorphic Variables ---\n");

  // A single trait object variable can hold different concrete types
  let item: dyn Describable = "a string";
  print("  ");
  print(item.describe());
  print("\n");

  item = Person.new("Bob", 25);
  print("  ");
  print(item.describe());
  print("\n");

  item = Book.new("The Ruyi Language", "Ruyi Team");
  print("  ");
  print(item.describe());
  print("\n");
}

// -----------------------------------------------------------------------------
// 5. Dynamic Dispatch via Function Parameters
// -----------------------------------------------------------------------------
// Dynamic dispatch: concrete type unknown at compile time
fn printDynamic(value: dyn Describable) {
  // This call goes through the vtable at runtime
  print("dynamic: ");
  print(value.describe());
  print("\n");
}

fn dynamicDispatchDemo() {
  print("--- Dynamic Dispatch ---\n");

  // Dynamic: type erased, dispatch through vtable
  printDynamic("dynamic dispatch");
  printDynamic(Person.new("Charlie", 40));
  printDynamic(Book.new("Learning Ruyi", "Ruyi Docs"));
}

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------
fn main() {
  print("=== Trait Objects (dyn Trait) Demo ===\n\n");

  singleTraitObjectDemo();
  print("\n");
  polymorphicVariableDemo();
  print("\n");
  dynamicDispatchDemo();

  print("\nAll trait object demos completed successfully!\n");
}
