// =============================================================================
// Traits - Ruyi Tutorial Chapter 8
// =============================================================================
// Covers: trait declarations, impl blocks,
//         default method implementations
// =============================================================================

// -----------------------------------------------------------------------------
// 8.2 Trait Declarations and Implementations
// -----------------------------------------------------------------------------
trait Printable {
  fn format(self): string;
}

impl Printable for string {
  fn format(self): string {
    return self;
  }
}

impl Printable for int {
  fn format(self): string {
    return self.toString();
  }
}

impl Printable for bool {
  fn format(self): string {
    if (self) {
      return "true";
    }
    return "false";
  }
}

// -----------------------------------------------------------------------------
// 8.5 Default Method Implementations
// -----------------------------------------------------------------------------
trait Stringable {
  fn toString(self): string;

  fn display(self) {
    print(self.toString());
    print("\n");
  }
}

// -----------------------------------------------------------------------------
// Demo functions that demonstrate trait concepts without method dispatch
// -----------------------------------------------------------------------------
fn traitDeclDemo() {
  print("--- Trait Declaration Demo ---\n");
  print("Printable trait declared with format(self): string\n");
  print("Implemented for: string, int, bool\n");
}

fn defaultMethodDemo() {
  print("--- Default Method Demo ---\n");
  print("Stringable trait with default display() method\n");
}

// -----------------------------------------------------------------------------
// Practical Example: Drawable (no trait method calls)
// -----------------------------------------------------------------------------
trait Drawable {
  fn draw(self);
  fn area(self): float;
}

class CircleDrawable {
  radius: float;
  fn new(radius: float) {
    self.radius = radius;
  }
}

class RectangleDrawable {
  width: float;
  height: float;
  fn new(width: float, height: float) {
    self.width = width;
    self.height = height;
  }
}

impl Drawable for CircleDrawable {
  fn draw(self) {
    print("Drawing circle with radius ");
    print(self.radius);
    print("\n");
  }

  fn area(self): float {
    return 3.14159 * self.radius ** 2;
  }
}

impl Drawable for RectangleDrawable {
  fn draw(self) {
    print("Drawing rectangle ");
    print(self.width);
    print("x");
    print(self.height);
    print("\n");
  }

  fn area(self): float {
    return self.width * self.height;
  }
}

fn practicalDemo() {
  print("--- Practical Example: Drawable Shapes ---\n");

  let circle = CircleDrawable.new(5.0);
  let rect = RectangleDrawable.new(4.0, 6.0);

  // Static dispatch demo
  circle.draw();
  print("  area: ");
  print(circle.area());
  print("\n");

  rect.draw();
  print("  area: ");
  print(rect.area());
  print("\n");
}

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------
fn main() {
  print("=== Traits Demo ===\n\n");

  traitDeclDemo();
  print("\n");
  defaultMethodDemo();
  print("\n");
  practicalDemo();

  print("\nAll traits demos completed successfully!\n");
}
