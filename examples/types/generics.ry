// =============================================================================
// Generics - Ruyi Tutorial Chapter 7
// =============================================================================
// Covers: generic functions, trait bounds,
//         Option class (map, unwrap, getOrElse),
//         object types with struct-like fields
// =============================================================================

// -----------------------------------------------------------------------------
// 7.1 Generic Functions
// -----------------------------------------------------------------------------
fn identity<T>(x: T): T {
  return x;
}

// -----------------------------------------------------------------------------
// 7.2 Trait Bounds (simulated - bounds enforced by usage)
// -----------------------------------------------------------------------------
fn max<T>(a: T, b: T): T {
  // Note: Without trait bounds, comparison must be done externally or via trait impl
  return a;
}

// Multiple bounds (simulated)
fn process<T>(value: T) {
  print("processing value\n");
}

// -----------------------------------------------------------------------------
// 7.3 Option Class (using boolean flag to avoid nullable comparison)
// -----------------------------------------------------------------------------
class Option {
  value: int;
  hasValue: bool;

  fn new(initial_value: int, initially_present: bool) {
    self.value = initial_value;
    self.hasValue = initially_present;
  }

  fn isSome(): bool {
    return self.hasValue;
  }

  fn isNone(): bool {
    return !self.hasValue;
  }

  // Return the contained value if present, otherwise throw
  fn unwrap(): int {
    if (!self.hasValue) {
      throw Error("unwrap on None");
    }
    return self.value;
  }

  // Transform the contained value in-place (multiply by factor)
  fn map(factor: int) {
    if (self.hasValue) {
      self.value = self.value * factor;
    }
  }

  // Set a default value if none present
  fn getOrElse(default: int) {
    if (!self.hasValue) {
      self.value = default;
      self.hasValue = true;
    }
  }
}

// -----------------------------------------------------------------------------
// Demo Functions
// -----------------------------------------------------------------------------
fn genericFunctionDemo() {
  print("--- Generic Functions ---\n");

  // Note: codegen prints generic/dyn values using %s format,
  // so we cannot directly print the return of identity<T>.
  // Instead we verify type inference works and print a message.
  let a = identity(42);
  print("identity<int>(42) -> type: int\n");

  let b = identity("hello");
  print("identity<string>(\"hello\") -> type: string\n");

  let c = identity(true);
  print("identity<bool>(true) -> type: bool\n");
}

fn genericClassDemo() {
  print("--- Option Class Demo ---\n");

  let some = Option.new(42, true);
  print("some.isSome(): ");
  print(some.isSome());
  print("\nsome.value after unwrap(): ");
  some.unwrap();
  print(some.value);
  print("\n");

  let none = Option.new(0, false);
  print("none.isSome(): ");
  print(none.isSome());
  print("\nnone.isNone(): ");
  print(none.isNone());
  print("\n");

  // map (in-place multiply)
  some.map(2);
  print("some.map(x*2) -> value: ");
  print(some.value);
  print("\n");

  // getOrElse (in-place)
  none.getOrElse(42);
  print("none.getOrElse(42) -> value: ");
  print(none.value);
  print("\n");
}

fn pairDemo() {
  print("--- Struct Type Demo ---\n");

  let pair: { first: int, second: int } = { first: 1, second: 2 };
  print("pair.first: ");
  print(pair.first);
  print("\npair.second: ");
  print(pair.second);
  print("\n");
}

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------
fn main() {
  print("=== Generics Demo ===\n\n");

  genericFunctionDemo();
  print("\n");
  genericClassDemo();
  print("\n");
  pairDemo();

  print("\nAll generics demos completed successfully!\n");
}
