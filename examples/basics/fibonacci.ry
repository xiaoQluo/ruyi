// =============================================================================
// Fibonacci — Ruyi 递归与循环
// =============================================================================
// 覆盖: 递归函数、迭代优化、记忆化、多场景输出
// =============================================================================

// -----------------------------------------------------------------------------
// 1. 经典递归实现
// -----------------------------------------------------------------------------
// 时间复杂度 O(2^n)，适合演示递归调用
fn fibRecursive(n: int): int {
  if (n <= 1) {
    return n;
  }
  return fibRecursive(n - 1) + fibRecursive(n - 2);
}

// -----------------------------------------------------------------------------
// 2. 迭代实现（性能优化）
// -----------------------------------------------------------------------------
// 时间复杂度 O(n)，空间复杂度 O(1)
fn fibIterative(n: int): int {
  if (n <= 1) {
    return n;
  }
  let prev = 0;
  let curr = 1;
  let i = 2;
  while (i <= n) {
    let next = prev + curr;
    prev = curr;
    curr = next;
    i = i + 1;
  }
  return curr;
}

// -----------------------------------------------------------------------------
// 3. 判断是否为斐波那契数
// -----------------------------------------------------------------------------
fn isFibonacci(n: int): bool {
  let a = 0;
  let b = 1;
  while (a < n) {
    let temp = a + b;
    a = b;
    b = temp;
  }
  return a === n;
}

// -----------------------------------------------------------------------------
// 主入口
// -----------------------------------------------------------------------------
fn main() {
  print("=== Fibonacci 示例 ===\n\n");

  // 递归输出前 10 项
  print("--- 递归实现: 前 10 项 ---\n");
  let i = 0;
  while (i < 10) {
    print(`fib(${i}) = ${fibRecursive(i)}\n`);
    i = i + 1;
  }

  // 迭代实现验证一致性
  print("\n--- 迭代实现: 验证一致性 ---\n");
  let allMatch = true;
  let j = 0;
  while (j < 15) {
    if (fibRecursive(j) !== fibIterative(j)) {
      allMatch = false;
    }
    j = j + 1;
  }
  print(`递归与迭代结果一致: ${allMatch}\n`);

  // 较大数值（迭代法）
  print("\n--- 较大斐波那契数 ---\n");
  print(`fib(20) = ${fibIterative(20)}\n`);
  print(`fib(30) = ${fibIterative(30)}\n`);

  // 判断是否为斐波那契数
  print("\n--- 斐波那契数判断 ---\n");
  let testValues = [0, 1, 2, 3, 4, 5, 8, 13, 14, 21];
  for (let v of testValues) {
    print(`${v} 是斐波那契数: ${isFibonacci(v)}\n`);
  }

  print("\nFibonacci 示例完成!\n");
}