// =============================================================================
// Operators - Ruyi 进阶运算符演示
// =============================================================================
// 覆盖(已实现的):
//   1. `instanceof` - 运行时类型检查,沿着继承链向上比对 type ID
//   2. `typeof`     - 取静态类型名(string:"int"/"string"/...)
//
// 未在 examples 中演示(spec.md 已声明但 codegen 尚未支持的):
//   - `as` 类型断言 (pattern alias `Pattern as Identifier` 除外)
//   - `void` 一元运算符 (仅 `void` 类型关键字)
//   - `delete` 一元运算符 (仅 dyn 对象/Map/Set 的属性删除)
//
// 注:以上三个运算符的 token 已被 lexer 识别,parser 也已建立 AST 节点,
//   但 codegen::compile_unary 走到 `Unsupported unary operator` 分支,使用
//   它们会得到 codegen 错误。这属于已知 P1 缺口,见 changes/v0.5.5 系列。
// =============================================================================

// -----------------------------------------------------------------------------
// 演示 1: instanceof
// -----------------------------------------------------------------------------
// 用法:<expr> instanceof <ClassName>
// 返回 bool:expr 的运行时类型是否是 ClassName(或其子类)

class Animal {
    name: string;
    fn new(name: string) {
        self.name = name;
    }
}

class Dog extends Animal {
    fn new(name: string) {
        super.new(name);
    }
}

class Cat extends Animal {
    fn new(name: string) {
        super.new(name);
    }
}

fn instanceofDemo() {
    print("=== 1. instanceof ===\n\n");

    let dog = Dog.new("Rex");
    let cat = Cat.new("Whiskers");
    let animal = Animal.new("Generic");

    // 自身类
    print("dog instanceof Dog:    ");
    print(dog instanceof Dog);
    print("  (期望 true)\n");
    print("cat instanceof Cat:    ");
    print(cat instanceof Cat);
    print("  (期望 true)\n\n");

    // 父类
    print("dog instanceof Animal: ");
    print(dog instanceof Animal);
    print("  (期望 true,Dog extends Animal)\n");
    print("cat instanceof Animal: ");
    print(cat instanceof Animal);
    print("  (期望 true)\n\n");

    // 不相关的类
    print("dog instanceof Cat:    ");
    print(dog instanceof Cat);
    print("  (期望 false,兄弟类不互兼)\n");
    print("animal instanceof Dog: ");
    print(animal instanceof Dog);
    print("  (期望 false,Animal 不是 Dog 子类)\n");
    print("\n");
}

// -----------------------------------------------------------------------------
// 演示 2: typeof
// -----------------------------------------------------------------------------
// 用法:typeof <expr>
// 返回 string:静态类型名("int"/"float"/"bool"/"string"/"null"/...)
// 注意:typeof 是编译期/静态分析,返回的是编译期推断的类型名,
// 而不是运行时的实际值的类型名。

fn typeofDemo() {
    print("=== 2. typeof ===\n\n");

    let n: int = 42;
    print("typeof 42:           ");
    print(typeof n);
    print("  (期望 \"int\")\n");

    let pi: float = 3.14;
    print("typeof pi:           ");
    print(typeof pi);
    print("  (期望 \"float\")\n");

    let flag: bool = true;
    print("typeof flag:         ");
    print(typeof flag);
    print("  (期望 \"bool\")\n");

    let s: string = "hello";
    print("typeof s:            ");
    print(typeof s);
    print("  (期望 \"string\")\n");

    let n2: int? = null;
    print("typeof n2 (nullable):");
    print(typeof n2);
    print("  (期望 \"int\",静态类型非 null 字面量)\n");

    let arr: Array<int> = [1, 2, 3];
    print("typeof arr:          ");
    print(typeof arr);
    print("  (期望 \"array\")\n");

    let dog = Dog.new("Rex");
    print("typeof dog:          ");
    print(typeof dog);
    print("  (期望 \"Dog\")\n");

    print("\n");
}

// -----------------------------------------------------------------------------
// 演示 3: 未实现的运算符
// -----------------------------------------------------------------------------
fn notImplementedDemo() {
    print("=== 3. Not Yet Implemented ===\n\n");
    print("以下运算符在 spec 中定义,但 codegen 暂未支持:\n");
    print("  - `as`      (类型断言;pattern alias 已支持)\n");
    print("  - `void <expr>` (一元;仅 void 类型关键字可用)\n");
    print("  - `delete <expr>` (一元;仅 dyn/Map/Set 属性删除可用)\n");
    print("\n");
    print("源码层面可读但不要写入 .ry 文件,会触发 codegen 错误:\n");
    print("  let x = some_dyn as string;       // ❌ codegen: Unsupported\n");
    print("  let v = void some_expr;          // ❌ codegen: Unsupported\n");
    print("  delete mapInstance[\"key\"];        // ❌ codegen: Unsupported\n");
    print("\n");
    print("spec.md 章节:\n");
    print("  §3.5.1 Optional Chaining §3.5.2 Nullish Coalescing 暂无 delete\n");
    print("  §3.5.7 Null Assert (§ null assertion `!` postfix 已实现)\n");
}

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------
fn main() {
    print("=== Operators Demo ===\n\n");

    instanceofDemo();
    typeofDemo();
    notImplementedDemo();

    print("\nAll operator demos completed successfully!\n");
}
