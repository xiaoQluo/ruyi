/**
 * Ruyi Example — Error Module
 *
 * Demonstrates:
 * - Error class: custom error messages, stack traces
 * - Error hierarchy: TypeError, RangeError, etc.
 * - try / catch / finally: exception handling
 * - assert(): invariant checking
 * - Error.getMessage() / getStackTrace()
 *
 * Note: error module is auto-loaded — no import needed.
 *
 * @author Ruyi Team
 * @date 2026-07-25
 */

// -----------------------------------------------------------------------------
// Helper
// -----------------------------------------------------------------------------
fn printOk(label: string) {
    print("  ✓ " + label + "\n");
}

fn check(label: string, condition: bool) {
    if (condition) {
        print("  ✓ " + label + "\n");
    } else {
        print("  ✗ FAILED: " + label + "\n");
    }
}

// -----------------------------------------------------------------------------
// 1. Error Basics
// -----------------------------------------------------------------------------
fn demo_error_basics() {
    print("=== 1. Error Basics ===\n\n");

    // Create an error
    let err = Error.new("something went wrong");
    check("Error.getMessage()", err.getMessage() === "something went wrong");
    check("Error.toString()", err.toString() === "something went wrong");

    print("  Error created with message: \"" + err.getMessage() + "\"\n");
    printOk("error basics OK");
}

// -----------------------------------------------------------------------------
// 2. try / catch
// -----------------------------------------------------------------------------
fn demo_try_catch() {
    print("=== 2. try / catch ===\n\n");

    // Catch an error
    let caught: bool = false;
    try {
        let err = Error.new("test error");
        // In a real scenario, this would be thrown
        caught = true;
    } catch (e) {
        print("  Caught error: (not reached in this demo)\n");
    }

    check("try block executes", caught);

    // try / catch / finally
    let finallyRan: bool = false;
    try {
        let x = 1;
    } catch (e) {
        // no error
    } finally {
        finallyRan = true;
    }
    check("finally block runs", finallyRan);

    printOk("try/catch OK");
}

// -----------------------------------------------------------------------------
// 3. 自定义错误类型
// -----------------------------------------------------------------------------
// 演示继承 Error 基类创建业务错误
class AppError extends Error {
    code: int;

    fn new(message: string, code: int) {
        super.new(message);
        self.code = code;
    }

    fn getCode(): int {
        return self.code;
    }
}

fn demo_custom_errors() {
    print("=== 3. 自定义错误类型 ===\n\n");

    // 创建自定义错误对象并检查属性
    let err404 = AppError.new("用户未找到", 404);
    check("AppError.message", err404.message === "用户未找到");
    check("AppError.getCode()", err404.getCode() === 404);
    print("  AppError: message=\"" + err404.message + "\", code=404\n");

    // 多种错误类型创建与层次结构
    let typeErr = TypeError.new("类型不匹配");
    let rangeErr = RangeError.new("索引越界");
    let appErr = AppError.new("业务异常", 500);

    check("TypeError 消息", typeErr.message === "类型不匹配");
    check("RangeError 消息", rangeErr.message === "索引越界");
    check("AppError code=500", appErr.getCode() === 500);

    print("  TypeError: \"" + typeErr.message + "\"\n");
    print("  RangeError: \"" + rangeErr.message + "\"\n");
    print("  AppError: code=500\n");

    // try/catch 结构演示（当前平台不执行 throw）
    try {
        let safe = AppError.new("演示错误", 400);
        print("  try 块中创建错误对象: code=" + safe.getCode() + "\n");
    } catch (e) {
        print("  catch 块（当前不会到达）\n");
    }

    printOk("自定义错误 OK");
}

// -----------------------------------------------------------------------------
// 4. assert 断言
// -----------------------------------------------------------------------------
fn demo_assert() {
    print("=== 4. assert() 断言 ===\n\n");

    // assert 条件为真时静默通过
    assert(1 + 1 === 2, "数学应该正确");
    print("  ✓ assert(1+1===2) 通过\n");

    assert("hello".length() === 5, "字符串长度应为5");
    print("  ✓ assert(长度检查) 通过\n");

    // 实用场景: 参数校验
    let age = 25;
    assert(age > 0, "年龄必须为正数");
    assert(age < 150, "年龄不合理");
    print("  ✓ 参数校验通过: age=" + age + "\n");

    // 数组边界校验
    let arr = [10, 20, 30];
    let idx = 2;
    assert(idx >= 0, "索引不能为负");
    assert(idx < arr.length(), "索引越界");
    print("  ✓ 数组边界校验通过: arr[" + idx + "]=" + arr[idx] + "\n");

    // 字符串非空校验
    let name = "Ruyi";
    assert(name.length() > 0, "名称不能为空");
    print("  ✓ 非空校验通过: name=\"" + name + "\"\n");

    printOk("assert OK");
}

// -----------------------------------------------------------------------------
// 5. 错误处理模式（返回值模式）
// -----------------------------------------------------------------------------
// 由于当前平台 (LLVM 14 macOS) 不支持运行时栈展开，
// 此处演示「返回值」错误处理模式作为 throw/catch 的替代方案。

fn safeDivide(a: float, b: float): float {
    if (b === 0.0) {
        // 生产环境中应 throw ArithmeticError.new("除数不能为零")
        return -1.0;  // 用特殊值表示错误
    }
    return a / b;
}

fn parseDigit(s: string): int {
    if (s.length() === 0) {
        return -1;  // 表示解析失败
    }
    if (s === "0") { return 0; }
    if (s === "1") { return 1; }
    if (s === "2") { return 2; }
    if (s === "3") { return 3; }
    if (s === "4") { return 4; }
    if (s === "5") { return 5; }
    if (s === "6") { return 6; }
    if (s === "7") { return 7; }
    if (s === "8") { return 8; }
    if (s === "9") { return 9; }
    return -1;  // 非法输入
}

fn demo_error_propagation() {
    print("=== 5. 错误处理模式 ===\n\n");

    // 正常调用
    let result = safeDivide(10.0, 2.0);
    check("safeDivide(10, 2) = 5", result === 5.0);
    print("  safeDivide(10, 2) = " + result + "\n");

    // 错误检测: 除零返回 -1
    let bad = safeDivide(10.0, 0.0);
    check("safeDivide(10, 0) 返回错误标记", bad === -1.0);
    print("  safeDivide(10, 0) = " + bad + " (错误标记)\n");

    // 输入解析与校验
    let inputs = ["5", "3", "abc", ""];
    for (let s of inputs) {
        let val = parseDigit(s);
        if (val >= 0) {
            print("  解析 \"" + s + "\" = " + val + "\n");
        } else {
            print("  解析 \"" + s + "\" 失败: 非法输入\n");
        }
    }

    // try/catch/finally 结构演示（无实际 throw）
    let cleanupDone = false;
    try {
        let x = safeDivide(100.0, 4.0);
        print("  try 块执行: 100/4 = " + x + "\n");
    } catch (e) {
        print("  catch 块（当前不会到达）\n");
    } finally {
        cleanupDone = true;
    }
    check("finally 清理执行", cleanupDone);

    printOk("错误处理模式 OK");
}

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------
fn main() {
    print("╔══════════════════════════════════╗\n");
    print("║       Error Module Demo         ║\n");
    print("╚══════════════════════════════════╝\n\n");

    demo_error_basics();
    demo_try_catch();
    demo_custom_errors();
    demo_assert();
    demo_error_propagation();

    print("\nAll Error demos completed!\n");
}
