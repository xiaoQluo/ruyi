// =============================================================================
// Ternary Operator — Ruyi 三元运算符
// =============================================================================
// 覆盖: 基础三元表达式、嵌套三元、与函数结合、多场景应用
// =============================================================================

// -----------------------------------------------------------------------------
// 1. 基础三元表达式
// -----------------------------------------------------------------------------
fn basicDemo() {
  print("--- 基础三元表达式 ---\n");

  let x = 10;
  // 条件 ? 真值 : 假值
  let result: int = x > 5 ? 1 : 0;
  print(`x = ${x}, x > 5 ? 1 : 0 = ${result}\n`);

  let y: int = x < 5 ? 1 : 0;
  print(`x < 5 ? 1 : 0 = ${y}\n`);
}

// -----------------------------------------------------------------------------
// 2. 字符串选择
// -----------------------------------------------------------------------------
fn stringSelectDemo() {
  print("--- 字符串选择 ---\n");

  let score = 85;
  // 根据分数选择等级
  let grade: string = score >= 90 ? "A" : score >= 80 ? "B" : score >= 70 ? "C" : "D";
  print(`分数 ${score} → 等级 ${grade}\n`);

  let isLoggedIn = true;
  let greeting: string = isLoggedIn ? "欢迎回来!" : "请先登录";
  print(`${greeting}\n`);
}

// -----------------------------------------------------------------------------
// 3. 与函数结合
// -----------------------------------------------------------------------------
fn absValue(n: int): int {
  // 用三元运算符实现绝对值
  return n >= 0 ? n : 0 - n;
}

fn maxOf(a: int, b: int): int {
  return a > b ? a : b;
}

fn minOf(a: int, b: int): int {
  return a < b ? a : b;
}

fn functionDemo() {
  print("--- 与函数结合 ---\n");

  print(`absValue(-7) = ${absValue(0 - 7)}\n`);
  print(`absValue(3) = ${absValue(3)}\n`);
  print(`maxOf(10, 20) = ${maxOf(10, 20)}\n`);
  print(`minOf(10, 20) = ${minOf(10, 20)}\n`);
}

// -----------------------------------------------------------------------------
// 4. 实用场景: 安全除法与默认值
// -----------------------------------------------------------------------------
fn safeDivide(a: float, b: float): float {
  // 避免除以零
  return b !== 0.0 ? a / b : 0.0;
}

fn practicalDemo() {
  print("--- 实用场景 ---\n");

  print(`safeDivide(10.0, 3.0) = ${safeDivide(10.0, 3.0)}\n`);
  print(`safeDivide(10.0, 0.0) = ${safeDivide(10.0, 0.0)}\n`);

  // 模拟 nullable 默认值
  let name: string? = null;
  let displayName: string = name !== null ? name! : "匿名用户";
  print(`显示名称: ${displayName}\n`);
}

// -----------------------------------------------------------------------------
// 主入口
// -----------------------------------------------------------------------------
fn main() {
  print("=== 三元运算符示例 ===\n\n");

  basicDemo();
  print("\n");
  stringSelectDemo();
  print("\n");
  functionDemo();
  print("\n");
  practicalDemo();

  print("\n三元运算符示例完成!\n");
}
