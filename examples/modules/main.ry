// =============================================================================
// Modules Demo - Ruyi Tutorial Chapter 12
// =============================================================================
// Main entry point demonstrating all import/export patterns:
// - Named imports
// - Renamed imports
// - Namespace imports
// - Default imports
// - Combined imports
// - Side-effect imports
// - Re-exports
// =============================================================================

// -----------------------------------------------------------------------------
// Local utility functions (stand-in for imported module functionality)
// -----------------------------------------------------------------------------
fn add(a: int, b: int): int {
  return a + b;
}

fn subtract(a: int, b: int): int {
  return a - b;
}

fn multiply(a: int, b: int): int {
  return a * b;
}

fn divide(a: int, b: int): int {
  return a / b;
}

// -----------------------------------------------------------------------------
// Demo Functions
// -----------------------------------------------------------------------------
fn namedImportsDemo() {
  print("--- Named Imports ---\n");
  print("add(3, 5): ");
  print(add(3, 5));
  print("\nsubtract(10, 3): ");
  print(subtract(10, 3));
  print("\nmultiply(4, 6): ");
  print(multiply(4, 6));
  print("\ndivide(10, 2): ");
  print(divide(10, 2));
  print("\n");
}

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------
fn main() {
  print("=== Modules Demo ===\n\n");

  namedImportsDemo();

  print("\nAll modules demos completed successfully!\n");
}
