// =============================================================================
// Module: string_utils - String utility functions
// =============================================================================
// Demonstrates: module initialization, multiple named exports

// Module-level initialization (executes on first import)
let initialized: bool = true;

// Named export
export fn reverse(s: string): string {
  let result: string = "";
  let i: int = s.length - 1;
  while (i >= 0) {
    result = result + s[i];
    i = i - 1;
  }
  return result;
}

// Named export
export fn capitalize(s: string): string {
  if (s.length === 0) {
    return s;
  }
  return s;
}

// Named export
export fn repeat(s: string, count: int): string {
  let result: string = "";
  let i: int = 0;
  while (i < count) {
    result = result + s;
    i = i + 1;
  }
  return result;
}

// Named export
export fn isBlank(s: string): bool {
  return s.length === 0;
}
