// =============================================================================
// Module: math - Math utility functions
// =============================================================================
// Demonstrates: named exports, re-exports, default exports

// Private helper (not exported)
fn internalHelper(a: int, b: int): int {
  return a + b;
}

// Named export
export fn add(a: int, b: int): int {
  return a + b;
}

// Named export
export fn subtract(a: int, b: int): int {
  return a - b;
}

// Named export
export fn multiply(a: int, b: int): int {
  return a * b;
}

// Named export with alias
export fn divide(a: int, b: int): int {
  if (b === 0) {
    throw Error("division by zero");
  }
  return a / b;
}

// Constant export
export const PI: float = 3.14159;
export const E: float = 2.71828;

// Default export
export default fn compute(a: int, b: int, op: string): int {
  match (op) {
    "+" => { return add(a, b); }
    "-" => { return subtract(a, b); }
    "*" => { return multiply(a, b); }
    "/" => { return divide(a, b); }
    _ => { throw Error("unknown operator: " + op); }
  }
}
