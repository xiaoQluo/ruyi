// member_access.ry — obj.field, obj?.field, obj["key"]
// Demonstrates v0.2 P0 (task 1.12): member expression codegen.

class Point {
  x: int;
  y: int;

  fn new(x: int, y: int) {
    self.x = x;
    self.y = y;
  }
}

fn main() {
  // Direct member access
  let p = Point.new(3, 4);
  print("p.x=");
  print(p.x);
  print("\n");
  print("p.y=");
  print(p.y);
  print("\n");

  // Safe access on nullable
  let nullable: Point? = p;
  print("nullable?.x=");
  print(nullable?.x);
  print("\n");

  // Bracket access via string key
  print("p[\"x\"]=");
  print(p["x"]);
  print("\n");

  let null_p: Point? = null;
  print("null_p?.x=");
  print(null_p?.x);
  print("\n");
}