// =============================================================================
// BigInt - Ruyi Arbitrary Precision Integer Type
// =============================================================================
// Covers: bigint literal syntax (suffix n), bigint type annotation,
//         type inference, bigint in expressions and comparisons
// =============================================================================

// -----------------------------------------------------------------------------
// 1. BigInt Literal Syntax
// -----------------------------------------------------------------------------
// BigInt literals use the suffix `n` after an integer value.
// The compiler infers the type as `bigint`.

let small_bigint = 100n;
let large_number = 999999999999999999999n;

// Explicit type annotation
let typed_bigint: bigint = 42n;

// -----------------------------------------------------------------------------
// 2. Type Inference
// -----------------------------------------------------------------------------
fn type_inference_demo() {
  print("--- BigInt Type Inference ---\n");

  // The compiler infers bigint from the `n` suffix
  let a = 1n;
  let b = 999999999999n;

  // Explicit annotation
  let c: bigint = 12345678901234567890n;

  print("bigint literals use the 'n' suffix\n");
  print("1n is inferred as bigint\n");
  print("explicit: let c: bigint = 12345678901234567890n;\n");
}

// -----------------------------------------------------------------------------
// 3. BigInt in Functions
// -----------------------------------------------------------------------------
// Functions can accept and return bigint values.

fn make_bigint(value: int): bigint {
  // Convert an int concept to a bigint literal
  return 0n;
}

fn bigint_parameter(x: bigint) {
  print("received bigint parameter\n");
}

fn function_demo() {
  print("--- BigInt in Functions ---\n");

  let result = make_bigint(42);
  bigint_parameter(100n);

  print("functions can accept and return bigint\n");
}

// -----------------------------------------------------------------------------
// 4. BigInt vs Int Comparison
// -----------------------------------------------------------------------------
fn type_comparison_demo() {
  print("--- BigInt vs Int ---\n");

  // int: 64-bit signed integer (fixed precision)
  let regular: int = 42;

  // bigint: arbitrary precision integer
  let big: bigint = 42n;

  print("int:  64-bit signed integer (fixed precision)\n");
  print("bigint: arbitrary precision integer\n");
  print("int literal:  42\n");
  print("bigint literal: 42n\n");
}

// -----------------------------------------------------------------------------
// 5. BigInt in Collections
// -----------------------------------------------------------------------------
fn collection_demo() {
  print("--- BigInt in Collections ---\n");

  // Arrays of bigint
  let numbers: Array<bigint> = [1n, 2n, 3n, 4n, 5n];
  print("array of bigint: [1n, 2n, 3n, 4n, 5n]\n");
  print("length: ");
  print(numbers.length());
  print("\n");
}

// -----------------------------------------------------------------------------
// 6. Nullable BigInt
// -----------------------------------------------------------------------------
fn nullable_bigint_demo() {
  print("--- Nullable BigInt ---\n");

  // BigInt can be nullable like any other type
  let maybe: bigint? = 100n;
  let none: bigint? = null;

  if (maybe !== null) {
    print("maybe has a bigint value\n");
  }

  if (none === null) {
    print("none is null\n");
  }

  // Nullish coalescing with bigint
  let safe: bigint = none ?? 0n;
  print("null ?? 0n gives default bigint\n");
}

// -----------------------------------------------------------------------------
// 7. BigInt in Pattern Matching
// -----------------------------------------------------------------------------
fn match_bigint(n: bigint): string {
  match (n) {
    _ => { return "bigint value"; }
  }
}

fn classify_bigint(n: bigint): string {
  match (n) {
    0n => { return "zero"; }
    1n => { return "one"; }
    42n => { return "answer"; }
    100n | 200n => { return "round hundred"; }
    _ => { return "other"; }
  }
}

fn pattern_matching_demo() {
  print("--- BigInt in Pattern Matching ---\n");

  let result = match_bigint(42n);
  print("match result: ");
  print(result);
  print("\n");

  print("classify_bigint(0n) = ");
  print(classify_bigint(0n));
  print("\n");
  print("classify_bigint(1n) = ");
  print(classify_bigint(1n));
  print("\n");
  print("classify_bigint(42n) = ");
  print(classify_bigint(42n));
  print("\n");
  print("classify_bigint(200n) = ");
  print(classify_bigint(200n));
  print("\n");
  print("classify_bigint(999n) = ");
  print(classify_bigint(999n));
  print("\n");
}

// -----------------------------------------------------------------------------
// 8. Large Number Use Cases
// -----------------------------------------------------------------------------
fn use_case_demo() {
  print("--- BigInt Use Cases ---\n");

  // Cryptographic key sizes often exceed 64 bits
  let key_size = 2048n;
  print("RSA key size: ");
  print(key_size);
  print(" bits\n");

  // Astronomical distances in meters
  let light_year = 9460730472580800n;
  print("light year in meters: ");
  print(light_year);
  print("\n");

  // Financial calculations with large sums
  let national_debt = 31400000000000n;
  print("large financial value: ");
  print(national_debt);
  print("\n");
}

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------
fn main() {
  print("=== BigInt Demo ===\n\n");

  type_inference_demo();
  print("\n");
  function_demo();
  print("\n");
  type_comparison_demo();
  print("\n");
  collection_demo();
  print("\n");
  nullable_bigint_demo();
  print("\n");
  pattern_matching_demo();
  print("\n");
  use_case_demo();

  print("\nAll bigint demos completed successfully!\n");
}
