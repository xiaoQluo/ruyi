/**
 * Ruyi Thread Example — Multi-threading with Channel communication
 *
 * Demonstrates:
 * - thread::spawn / join / detach
 * - Channel for inter-thread communication
 * - thread::id / cpuCount
 * - thread_local storage
 *
 * @author Ruyi Team
 * @date 2026-07-25
 */

import { Thread } from "../stdlib/thread";
import { Channel } from "../stdlib/channel";

fn worker(sender, id) {
    let msg = "hello from worker " + id;
    sender.send(msg);
    sender.close();
}

fn main() {
    let cpu = Thread.cpuCount();
    print("CPU count: " + cpu);

    // Basic thread spawn + join
    let t1 = Thread.spawn(fn(arg) { print("thread " + Thread.id() + " running"); });
    t1.join();
    print("t1 joined");

    // Channel communication: spawn N workers, collect results
    let ch = Channel.new();
    let n = 4;
    for (let i = 0; i < n; i = i + 1) {
        let s = ch.sender();
        Thread.spawn(fn(arg) { worker(s, arg); }, i);
    }
    ch.close();

    let count = 0;
    while (true) {
        let msg = ch.recv();
        if (msg === null) { break; }
        print("received: " + msg);
        count = count + 1;
    }
    print("total received: " + count + " / " + n);

    // Detached thread (fire-and-forget)
    let dt = Thread.spawn(fn(arg) {
        for (let i = 0; i < 1000; i = i + 1) {}
    });
    dt.detach();
    print("detached — main continues without waiting");

    print("done");
}
