// v05_demo.ry — v0.5 feature demo: arrays, pattern matching, classes, nullable types
// Note: These features are WIP. Compilation may fail.

// Class with methods
class Counter {
  count: int;
  fn new() {
    self.count = 0;
  }
  fn increment(self) {
    self.count = self.count + 1;
  }
  fn get(self): int {
    return self.count;
  }
}

// Pattern matching with guards
fn sign(n: int): string {
  match (n) {
    n if (n > 0) => { return "positive"; }
    n if (n < 0) => { return "negative"; }
    _ => { return "zero"; }
  }
}

// Pattern matching with match statement (expression form bypassed for codegen compat)
fn day_name(n: int): string {
  match (n) {
    1 => { return "Monday"; }
    2 => { return "Tuesday"; }
    3 => { return "Wednesday"; }
    _ => { return "Unknown"; }
  }
}

// Main demo
let counter = Counter.new();
counter.increment();
counter.increment();
counter.increment();
print("Counter: ");
print(counter.get());
print("\n");

print("sign(-5): ");
print(sign(-5));
print("\n");

print("day_name(3): ");
print(day_name(3));
print("\n");

// Nullable type demo (skip null check to avoid LLVM codegen hang)
let name: string? = "Ruyi v0.5";
print("Hello, ");
print(name);
print("\n");
