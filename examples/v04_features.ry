// v0.4 Typechecker Hardening - Feature Examples
// Demonstrates: trait bounds, supertraits, impl resolution,
// self-referential types, instanceof/typeof narrowing
//
// Note: Class field assignment codegen is not yet implemented.
// This file demonstrates typechecker features that are verified
// at compile time.

// ── 1. Trait Bounds Enforcement ──────────────────────────────────
// Generic functions enforce that type arguments satisfy trait bounds

trait Printable {
  fn format(self): string;
}

class Point {
  x: float;
  y: float;

  fn new(x: float, y: float) {
    self.x = x;
    self.y = y;
  }
}

impl Printable for Point {
  fn format(self): string {
    return "(" + self.x + ", " + self.y + ")";
  }
}

// ── 2. Supertrait Hierarchies ────────────────────────────────────
// Traits can extend other traits

trait Debug {
  fn debug(self): string;
}

trait Formattable extends Debug {
  fn format(self): string;
}

class Rectangle {
  width: float;
  height: float;

  fn new(w: float, h: float) {
    self.width = w;
    self.height = h;
  }
}

impl Debug for Rectangle {
  fn debug(self): string {
    return "Rectangle(" + self.width + "x" + self.height + ")";
  }
}

impl Formattable for Rectangle {
  fn format(self): string {
    return "[" + self.width + " x " + self.height + "]";
  }
}

// ── 3. Impl Method Resolution ────────────────────────────────────

class Circle {
  radius: float;

  fn new(r: float) {
    self.radius = r;
  }
}

impl Printable for Circle {
  fn format(self): string {
    return "Circle(r=" + self.radius + ")";
  }
}

// ── 4. Self-Referential Class Fields ─────────────────────────────
// Nullable self-references are allowed for linked structures

class ListNode {
  value: int;
  next: ListNode?;

  fn new(val: int, nxt: ListNode?) {
    self.value = val;
    self.next = nxt;
  }
}

// ── 5. Main ──────────────────────────────────────────────────────

fn main() {
  print("v0.4 Typechecker Hardening - Compile-time verification");
  print("All features verified by typechecker at compile time.");
  print("Runtime execution requires class field assignment codegen.");
}
