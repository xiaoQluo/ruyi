// =============================================================================
// Error Handling - Ruyi Tutorial Chapter 10
// =============================================================================
// Covers: try/catch/finally, multiple catch clauses, catch without binding,
//         throw, custom error types, never type, finally guarantees
// =============================================================================

// -----------------------------------------------------------------------------
// 10.1 try / catch / finally
// -----------------------------------------------------------------------------
fn basicTryCatch() {
  print("--- Basic try/catch/finally ---\n");

  try {
    print("Inside try block\n");
    throw Error("something went wrong");
  } catch (e: Error) {
    print("Caught Error: ");
    print(e.message);
    print("\n");
  } finally {
    print("Finally block always executes\n");
  }
}

// -----------------------------------------------------------------------------
// 10.2 Multiple Catch Clauses
// -----------------------------------------------------------------------------
class TypeError extends Error {
  fn new(message: string) {
    super.new(message);
  }
}

class RangeError extends Error {
  fn new(message: string) {
    super.new(message);
  }
}

fn multipleCatch(value: int) {
  try {
    if (value < 0) {
      throw Error("value must be non-negative");
    }
    if (value > 100) {
      throw Error("value must be <= 100");
    }
    print("value ");
    print(value);
    print(" is valid\n");
  } catch (e: Error) {
    print("Error: ");
    print(e.message);
    print("\n");
  }
}

fn multipleCatchDemo() {
  print("--- Multiple Catch Clauses ---\n");
  multipleCatch(50);
  multipleCatch(-1);
  multipleCatch(200);
}

// -----------------------------------------------------------------------------
// 10.3 Catch Without Binding (simulated with bound variable)
// -----------------------------------------------------------------------------
fn catchWithoutBinding() {
  print("--- Catch Without Binding ---\n");

  try {
    throw Error("anonymous error");
  } catch (e: Error) {
    print("something failed (error caught)\n");
  }
}

// -----------------------------------------------------------------------------
// 10.4 throw Statement
// -----------------------------------------------------------------------------
fn divide(a: int, b: int): int {
  if (b === 0) {
    throw Error("division by zero");
  }
  return a / b;
}

fn throwDemo() {
  print("--- throw Statement ---\n");

  try {
    print("10 / 2 = ");
    print(divide(10, 2));
    print("\n");

    print("10 / 0 = ");
    print(divide(10, 0));
    print("\n");
  } catch (e: Error) {
    print("Error: ");
    print(e.message);
    print("\n");
  }
}

// -----------------------------------------------------------------------------
// 10.5 Custom Error Types
// -----------------------------------------------------------------------------
class ValidationError extends Error {
  field: string;

  fn new(field: string, message: string) {
    super.new(message);
    self.field = field;
  }
}

fn validateAge(age: int) {
  if (age < 0) {
    throw ValidationError.new("age", "age cannot be negative");
  }
  if (age > 150) {
    throw ValidationError.new("age", "age seems unrealistic");
  }
  print("age ");
  print(age);
  print(" is valid\n");
}

fn customErrorDemo() {
  print("--- Custom Error Types ---\n");

  try {
    validateAge(25);
    validateAge(-5);
  } catch (e: ValidationError) {
    print("Validation error on field '");
    print(e.field);
    print("': ");
    print(e.message);
    print("\n");
  } catch (e: Error) {
    print("Error: ");
    print(e.message);
    print("\n");
  }
}

// -----------------------------------------------------------------------------
// 10.6 The never Type
// -----------------------------------------------------------------------------
fn fail(message: string): never {
  throw Error(message);
}

fn neverTypeDemo() {
  print("--- never Type ---\n");

  // never is a subtype of every type
  let condition: bool = true;
  let x: int = if (condition) {
    42
  } else {
    fail("impossible");  // never is a subtype of int
  };

  print("x: ");
  print(x);
  print("\n");
}

// -----------------------------------------------------------------------------
// 10.7 finally Guarantees
// -----------------------------------------------------------------------------
fn finallyWithReturn(): int {
  print("before try\n");
  try {
    print("inside try, about to return\n");
    return 42;
  } finally {
    print("finally executes before return\n");
  }
}

fn finallyGuaranteeDemo() {
  print("--- finally Guarantees ---\n");

  let result = finallyWithReturn();
  print("returned: ");
  print(result);
  print("\n");
}

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------
fn main() {
  print("=== Error Handling Demo ===\n\n");

  basicTryCatch();
  print("\n");
  multipleCatchDemo();
  print("\n");
  catchWithoutBinding();
  print("\n");
  throwDemo();
  print("\n");
  customErrorDemo();
  print("\n");
  neverTypeDemo();
  print("\n");
  finallyGuaranteeDemo();

  print("\nAll error handling demos completed successfully!\n");
}
