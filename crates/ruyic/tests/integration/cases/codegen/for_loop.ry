// for_loop.ry — C-style, for-of array, for-in object
fn main() {
  // C-style for
  let sum = 0;
  for (let i = 0; i < 5; i = i + 1) {
    sum = sum + i;
  }
  print(sum);

  // for-of array
  let arr = [10, 20, 30];
  for (let v of arr) {
    print(v);
  }

  // for-in object
  let obj: { a: int, b: int, c: int } = { a: 1, b: 2, c: 3 };
  for (let k in obj) {
    print(k);
  }
}