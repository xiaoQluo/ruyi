// member_access.ry — .field, ?.field, ["key"]
class Point {
  x: int;
  y: int;

  fn new(x: int, y: int) {
    self.x = x;
    self.y = y;
  }
}

fn main() {
  let p = Point.new(3, 4);
  // .field
  print(p.x);
  print(p.y);

  // ?.-style safe access on non-null
  let maybe: Point? = p;
  print(maybe?.x);

  // ["key"] bracket access
  print(p["x"]);

  // ?. on null yields 0
  let null_p: Point? = null;
  print(null_p?.x);
}