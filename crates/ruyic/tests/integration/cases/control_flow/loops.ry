let i: int = 0;
while (i < 5) {
    print(i);
    i = i + 1;
}

print("---");

let count: int = 3;
while (count > 0) {
    print(count);
    count = count - 1;
}

print("---");

for (let j: int = 0; j < 3; j = j + 1) {
    print(j);
}

print("---");

let sum: int = 0;
for (let k: int = 1; k <= 5; k = k + 1) {
    sum = sum + k;
}
print(sum);