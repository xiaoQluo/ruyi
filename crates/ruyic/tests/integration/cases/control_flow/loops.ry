let i = 0;
while i < 5 {
    print(i);
    i = i + 1;
}

print("---");

let count = 3;
while count > 0 {
    print(count);
    count = count - 1;
}

print("---");

for let j = 0; j < 3; j = j + 1 {
    print(j);
}

print("---");

let sum = 0;
for let k = 1; k <= 5; k = k + 1 {
    sum = sum + k;
}
print(sum);