let x = 10;

if x > 5 {
    print("x is greater than 5");
} else {
    print("x is not greater than 5");
}

let y = 0;
if y == 0 {
    print("y is zero");
} else if y > 0 {
    print("y is positive");
} else {
    print("y is negative");
}

let counter = 0;
while counter < 3 {
    print("Counter: " + counter);
    counter = counter + 1;
}

let sum = 0;
for let i = 1; i <= 5; i = i + 1 {
    sum = sum + i;
}
print("Sum 1..5 = " + sum);